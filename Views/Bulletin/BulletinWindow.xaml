<Window x:Class="SIGFUR.Wpf.Views.Bulletin.BulletinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        xmlns:services="clr-namespace:SIGFUR.Wpf.Services"
        Title="SIGFUR — Boletim" Width="1520" Height="920" MinWidth="1180" MinHeight="760" FontSize="12.5"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/SIGFUR;component/Assets/sigfur.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PrimaryGradientBrush}" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Preparar publicação" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="1. Escolha o assunto  •  2. Selecione os militares  •  3. Preencha  •  4. Confira  •  5. Gere ou envie" Foreground="#DCEBFF" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Sessão compartilhada" Foreground="#DCEBFF" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Text="Prepare o SisBol somente na tela principal" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border x:Name="SisbolBadge" Background="#1EFFFFFF" CornerRadius="16" Padding="12,7">
                        <TextBlock x:Name="SisbolStatusText" Text="SisBol não preparado" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Novo modelo" Style="{StaticResource PrimaryButtonStyle}" Click="NewTemplate_Click" Margin="0,0,8,0" MinWidth="112"/>
                    <Button Content="Editar modelo" Style="{StaticResource SecondaryButtonStyle}" Click="EditTemplate_Click" Margin="0,0,8,0" MinWidth="108"/>
                    <Button Content="Duplicar" Style="{StaticResource SecondaryButtonStyle}" Click="DuplicateTemplate_Click" Margin="0,0,8,0" MinWidth="88"/>
                    <Button Content="Mais ferramentas ▾" Style="{StaticResource GhostButtonStyle}" Click="OpenBulletinTools_Click" Margin="0,0,12,0" MinWidth="132" ToolTip="Referências, chaves e utilitários do boletim">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Chaves salvas" Click="SavedKeys_Click"/>
                                <MenuItem Header="Usar BI/ADT salvo" Click="SavedBulletin_Click"/>
                                <MenuItem Header="Enviados ao SISBOL" Click="SisbolHistory_Click"/>
                                <MenuItem Header="Boletins externos" Click="ExternalBulletins_Click"/>
                                <Separator/>
                                <MenuItem Header="Excluir modelo selecionado" Click="DeleteTemplate_Click"/>
                                <Separator/>
                                <MenuItem Header="Converter valor por extenso" Click="NumberToWords_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <CheckBox x:Name="LockBulletinOrderCheck" Content="Travar ordem" Checked="LockBulletinOrderCheck_Changed" Unchecked="LockBulletinOrderCheck_Changed" VerticalAlignment="Center" ToolTip="Bloqueia o arraste dos modelos e dos militares."/>
                </WrapPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0">
                    <Button Content="Gerar prévia" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" Margin="0,0,8,0" MinWidth="108"/>
                    <Button Content="Copiar para Word" Style="{StaticResource SecondaryButtonStyle}" Click="CopyWord_Click" Margin="0,0,8,0" MinWidth="125"/>
                    <Button x:Name="SendSisbolButton" Content="Enviar ao SisBol" Style="{StaticResource PrimaryButtonStyle}" Click="SendSisbol_Click" MinWidth="128"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SelectionRow" Height="280" MinHeight="220"/>
                <RowDefinition x:Name="SelectionSplitterRow" Height="6"/>
                <RowDefinition x:Name="WorkRow" Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="11,10,11,7">
                        <TextBlock Text="MODELOS DE BOLETIM" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Arraste para salvar a ordem; use ‘Travar ordem’ para evitar mudanças acidentais." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="TemplateCategoryBox" Grid.Row="1" Margin="10,0,10,7" Padding="7,5" FontSize="12"
                              SelectionChanged="TemplateCategoryBox_SelectionChanged" ToolTip="Filtrar modelos por assunto">
                        <ComboBoxItem Content="Todos os assuntos" IsSelected="True"/>
                        <ComboBoxItem Content="Cadastro e movimentação"/>
                        <ComboBoxItem Content="Adicionais e direitos"/>
                        <ComboBoxItem Content="Benefícios e dependentes"/>
                        <ComboBoxItem Content="Saúde, moradia e descontos"/>
                        <ComboBoxItem Content="Pagamentos especiais"/>
                        <ComboBoxItem Content="Outros assuntos"/>
                    </ComboBox>
                    <TextBox x:Name="TemplateSearchBox" Grid.Row="2" Margin="10,0,10,7" Padding="8,6" FontSize="12" TextChanged="TemplateSearch_TextChanged" ToolTip="Pesquisar por assunto ou nome"/>
                    <ListBox x:Name="TemplateList" Grid.Row="3" Margin="8,0" SelectionChanged="TemplateList_SelectionChanged"
                             FontSize="12" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonDown="TemplateList_PreviewMouseLeftButtonDown" PreviewMouseMove="TemplateList_PreviewMouseMove"
                             AllowDrop="True" Drop="TemplateList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9,7" Margin="1,2" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceElevatedBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource PrimaryBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="7">
                        <Button Content="▲" Style="{StaticResource GhostButtonStyle}" Click="MoveTemplateUp_Click" Width="44"/>
                        <Button Content="▼" Style="{StaticResource GhostButtonStyle}" Click="MoveTemplateDown_Click" Width="44" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SelectionCollapsedBar" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="10,7" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionCollapsedSummaryText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="Mostrar seleção de militares" Style="{StaticResource PrimaryButtonStyle}" Click="ShowSelectionArea_Click" MinWidth="178"/>
                </Grid>
            </Border>

            <Border x:Name="AvailableSelectionPanel" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="11,10,11,7">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="2">
                            <TextBlock Text="MILITARES DISPONÍVEIS" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="AvailableCountText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="IncludeLicensedTransferredCheck" Content="Mostrar lic./transf." FontSize="10.5"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="Exibe militares licenciados e transferidos junto com os ativos."
                                      Checked="IncludeLicensedTransferredCheck_Changed" Unchecked="IncludeLicensedTransferredCheck_Changed"/>
                            <ComboBox x:Name="AvailableSortBox" Width="178" FontSize="10.8" SelectionChanged="AvailableSortBox_SelectionChanged">
                                <ComboBoxItem Content="Ordem salva (Listar Militares)"/>
                                <ComboBoxItem Content="Posto/Graduação + Nome"/>
                                <ComboBoxItem Content="Somente Nome (A→Z)"/>
                                <ComboBoxItem Content="ID (cadastro)"/>
                            </ComboBox>
                            <Button x:Name="ToggleSelectionSizeButton" Content="Ampliar" Style="{StaticResource GhostButtonStyle}" Click="ToggleSelectionSize_Click" MinWidth="68" Margin="8,0,0,0"/>
                            <Button Content="Ocultar" Style="{StaticResource GhostButtonStyle}" Click="HideSelectionArea_Click" MinWidth="64" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </Grid>
                    <TextBox x:Name="MilitarySearchBox" Grid.Row="1" Margin="10,0,10,6" Padding="7,5" FontSize="11.5" TextChanged="MilitarySearch_TextChanged" ToolTip="Pesquisar por nome, CPF, Prec-CP ou posto"/>
                    <DataGrid x:Name="AvailableGrid" Grid.Row="2" Margin="8,0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              FontSize="10.8" RowHeight="23" ColumnHeaderHeight="24" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="AvailableGrid_MouseDoubleClick"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="FontSize" Value="9.8"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Adicionar selecionados ao boletim" Click="AddSelected_Click"/>
                                <MenuItem Header="Adicionar marcados" Click="AddMarked_Click"/>
                                <Separator/>
                                <MenuItem Header="Selecionar todos os visíveis" Click="SelectAllAvailable_Click"/>
                                <MenuItem Header="Limpar seleção" Click="ClearAvailableSelection_Click"/>
                                <Separator/>
                                <MenuItem Header="Copiar selecionados" Click="CopyAvailableSelection_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="P/G" Binding="{Binding ShortRank}" SortMemberPath="RankSortKey" Width="42"/>
                            <DataGridTemplateColumn Header="Nome" Width="*" MinWidth="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Name}" WarName="{Binding WarName}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CPF" Binding="{Binding FormattedCpf}" Width="94"/>
                            <DataGridTextColumn Header="Origem" Binding="{Binding BulletinSource}" Width="58"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="6" HorizontalAlignment="Center">
                        <Button Content="Adicionar selecionados →" Style="{StaticResource PrimaryButtonStyle}" Click="AddSelected_Click"/>
                        <Button Content="Adicionar marcados" Style="{StaticResource SecondaryButtonStyle}" Click="AddMarked_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SelectedSelectionPanel" Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="11,10,11,7">
                        <TextBlock Text="ORDEM NO BOLETIM" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="SelectedCountText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="SelectedGrid" Grid.Row="1" Margin="8,0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              FontSize="10.8" RowHeight="38" ColumnHeaderHeight="26" SelectionMode="Extended" SelectionUnit="FullRow" AllowDrop="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              PreviewMouseLeftButtonDown="SelectedGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="SelectedGrid_PreviewMouseMove" Drop="SelectedGrid_Drop">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="FontSize" Value="9.8"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Remover selecionados" Click="RemoveSelected_Click"/>
                                <MenuItem Header="Mover para cima" Click="MoveSelectedUp_Click"/>
                                <MenuItem Header="Mover para baixo" Click="MoveSelectedDown_Click"/>
                                <Separator/>
                                <MenuItem Header="Selecionar todos" Click="SelectAllSelected_Click"/>
                                <MenuItem Header="Limpar seleção" Click="ClearSelectedSelection_Click"/>
                                <Separator/>
                                <MenuItem Header="Copiar selecionados" Click="CopySelectedSelection_Click"/>
                                <Separator/>
                                <MenuItem Header="Limpar lista do boletim" Click="ClearSelected_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="26"/>
                            <DataGridTextColumn Header="P/G" Binding="{Binding Military.ShortRank}" SortMemberPath="Military.RankSortKey" Width="42"/>
                            <DataGridTemplateColumn Header="Nome" Width="*" MinWidth="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Military.Name}" WarName="{Binding Military.WarName}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Dados individuais" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IndividualDataStatus}" VerticalAlignment="Center" FontSize="10.5"
                                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,6,0"/>
                                            <Button Grid.Column="1" Content="{Binding IndividualActionLabel}" IsEnabled="{Binding CanEditIndividualData}"
                                                    Style="{StaticResource GhostButtonStyle}" Padding="7,2" MinWidth="58" FontSize="10.5"
                                                    Click="EditIndividualMilitary_Click" ToolTip="Abrir e preencher os dados somente deste militar"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Origem" Binding="{Binding Military.BulletinSource}" Width="58"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="6" HorizontalAlignment="Center">
                        <Button Content="← Remover" Style="{StaticResource DangerButtonStyle}" Click="RemoveSelected_Click" Margin="0,0,8,8"/>
                        <Button Content="▲" Style="{StaticResource GhostButtonStyle}" Click="MoveSelectedUp_Click" Width="44" Margin="0,0,8,8"/>
                        <Button Content="▼" Style="{StaticResource GhostButtonStyle}" Click="MoveSelectedDown_Click" Width="44" Margin="0,0,8,8"/>
                        <Button Content="Limpar" Style="{StaticResource GhostButtonStyle}" Click="ClearSelected_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="SelectionGridSplitter" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS" ToolTip="Arraste para ajustar o espaço entre militares e preenchimento"/>

            <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl x:Name="WorkTabs" BorderThickness="0" SelectionChanged="WorkTabs_SelectionChanged">
                    <TabItem Header="1 · Preencher">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="FieldsSummaryText" Text="Preencha os dados usados no texto" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Preencha os dados gerais e os dados de cada militar. A conferência acompanha suas alterações e indica o que precisa ser corrigido." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                                        <TextBlock x:Name="FieldsProgressText" Text="0 de 0 preenchidos" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                                <StackPanel x:Name="FieldsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ComplianceTab" Header="2 · Conferir SIPPES">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                                <StackPanel x:Name="CompliancePanel"/>
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pendências impedem a geração. Orientações exigem conferência do operador. A validação local não substitui a análise do direito e dos documentos de origem." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Grid.Column="1" Content="Atualizar conferência" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshCompliance_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="AuditAiButton" Grid.Column="2" Content="✦ Auditar com IA" Style="{StaticResource PrimaryButtonStyle}" Click="AuditWithAi_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="PreviewTab" Header="3 · Revisar publicação">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <FlowDocumentScrollViewer x:Name="PreviewDocumentViewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Margin="8"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                                <Button Content="Copiar texto" Style="{StaticResource GhostButtonStyle}" Click="CopyText_Click"/>
                                <Button Content="Salvar .txt" Style="{StaticResource SecondaryButtonStyle}" Click="SaveText_Click" Margin="8,0,0,0"/>
                                <Button Content="Copiar Word" Style="{StaticResource PrimaryButtonStyle}" Click="CopyWord_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Texto do modelo">
                        <Grid Margin="10">
                            <TextBox x:Name="RawTemplateBox" Tag="UiState.NoPersist" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="12"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="255">
                        <TextBlock Text="Fechamento" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="IncludeConsequencesCheck" Content="SisBol" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="Envia este texto ao campo de fechamento do SisBol."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Carregando boletim…" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="10.8"/>
                        <TextBlock x:Name="ConsequencesCompactText" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" FontSize="11.2" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="UnresolvedText" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <Button x:Name="ToggleConsequencesButton" Content="Mostrar" Style="{StaticResource GhostButtonStyle}" Click="ToggleConsequences_Click" MinWidth="74" Margin="0,0,6,0"/>
                        <Button Content="Editar maior" Style="{StaticResource GhostButtonStyle}" Click="EditConsequencesLarge_Click" MinWidth="102"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="ConsequencesTextBox"
                         Grid.Row="1"
                         Text="{x:Static services:SisbolTexts.BulletinConsequencesText}"
                         Visibility="Collapsed"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top"
                         FontFamily="Segoe UI"
                         FontSize="12"
                         Height="72"
                         Padding="8,6"
                         Margin="0,6,0,0"
                         TextChanged="ConsequencesTextBox_TextChanged"
                         ToolTip="Texto editável enviado exclusivamente ao campo Texto de Fechamento do SisBol."/>
            </Grid>
        </Border>

        <controls:SigfurLoadingOverlay x:Name="LoadingOverlay"
                                       Grid.RowSpan="3"
                                       Panel.ZIndex="50"
                                       Visibility="Collapsed"
                                       Title="Carregando boletim"
                                       Message="Aguarde..."/>
    </Grid>
</Window>
