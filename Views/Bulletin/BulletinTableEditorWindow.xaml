<Window x:Class="SIGFUR.Wpf.Views.Bulletin.BulletinTableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGFUR — Criar tabela para o SisBol" Width="1120" Height="760" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico" Tag="UiState.BoundsOnly">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PrimaryGradientBrush}" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TABELA COMPATÍVEL COM O SISBOL" Foreground="White" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="Defina o tamanho, ajuste as colunas ou cole diretamente do Excel. A ordem será preservada no PDF." Foreground="#DCEBFF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="18,14,18,10" Padding="14">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Linhas" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0"/>
                <ComboBox x:Name="RowsBox" Width="72" SelectionChanged="Dimensions_Changed" Margin="0,0,18,0"/>
                <TextBlock Text="Colunas" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0"/>
                <ComboBox x:Name="ColumnsBox" Width="72" SelectionChanged="Dimensions_Changed" Margin="0,0,18,0"/>
                <TextBlock Text="Largura no boletim" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0"/>
                <ComboBox x:Name="WidthBox" Width="92" IsEditable="True" Margin="0,0,18,0">
                    <ComboBoxItem Content="60%"/><ComboBoxItem Content="70%"/><ComboBoxItem Content="80%"/><ComboBoxItem Content="90%"/><ComboBoxItem Content="100%"/>
                </ComboBox>
                <CheckBox x:Name="HeaderCheck" Content="Primeira linha em negrito" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Button Content="Colar do Word/Excel" Style="{StaticResource SecondaryButtonStyle}" Click="PasteExcel_Click" Padding="12,6"/>
                <TextBlock x:Name="ImportStatusText" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="14,0,0,0" MaxWidth="360"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="18,0,18,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Conteúdo das células" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CellsGrid"/>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Margin="2,9,0,0">
                <TextBlock Text="Largura de cada coluna (%) — o SIGFUR ajusta automaticamente para totalizar 100%." Foreground="{DynamicResource MutedBrush}"/>
                <WrapPanel x:Name="ColumnWidthsPanel" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <TextBlock Text="Dica: copie a tabela no Word ou Excel; o SIGFUR reconhece dimensões e proporção das colunas." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Aplicar tabela" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
