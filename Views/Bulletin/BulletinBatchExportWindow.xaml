<Window x:Class="SIGFUR.Wpf.Views.Bulletin.BulletinBatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGFUR — Exportar boletins em ordem" Width="1040" Height="760"
        MinWidth="880" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico">
    <Window.Resources>
        <Style x:Key="ExportGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PrimaryDarkBrush}" Padding="22,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="EXPORTAR BOLETINS EM ORDEM" Foreground="White" FontWeight="Bold" FontSize="20"/>
                <TextBlock x:Name="HeaderSubtitleText" Text="Escolha o ano e o intervalo. O SIGFUR criará uma pasta pronta para envio."
                           Foreground="{DynamicResource TextOnPrimaryMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="16,14,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/><ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ano" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="YearBox" MinHeight="36" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Número inicial" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox x:Name="StartNumberBox" MinHeight="36" TextChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Número final" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox x:Name="EndNumberBox" MinHeight="36" TextChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Pasta de destino" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox x:Name="DestinationBox" MinHeight="36" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="7" Content="Escolher pasta" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click" Margin="8,20,0,0" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource InsetCardStyle}" Padding="12" Margin="0,0,0,9">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                        <TextBlock x:Name="MissingText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="PreferSignedCheck" Content="Preferir PDF assinado" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="Marcar todos" Style="{StaticResource GhostButtonStyle}" Click="SelectAll_Click" Margin="0,0,7,0"/>
                        <Button Content="Desmarcar" Style="{StaticResource GhostButtonStyle}" Click="SelectNone_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1" x:Name="PreviewGrid" Style="{StaticResource ExportGridStyle}" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Exportar" Binding="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                    <DataGridTextColumn Header="Ordem" Binding="{Binding Sequence}" Width="62" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Boletim" Binding="{Binding Reference}" Width="145" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="125" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Arquivo original" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="135" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Informe o intervalo para preparar a exportação."
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,540,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Content="Exportar e abrir pasta" Style="{StaticResource SecondaryButtonStyle}" Click="Export_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ExportAndEmailButton" Content="Exportar e enviar pelo EBMail" Style="{StaticResource PrimaryButtonStyle}" Click="ExportAndEmail_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
