<Window x:Class="SIGFUR.Wpf.Views.Vacation.VacationPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        xmlns:services="clr-namespace:SIGFUR.Wpf.Services"
        Title="SIGFUR — Plano de Férias" Width="1240" Height="760" MinWidth="980" MinHeight="610" FontSize="10.5"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico">
    <Window.Resources>
        <!-- Layout compacto para monitores menores do quartel: mais linhas visíveis e menos corte nas tabelas. -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
        </Style>
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        </Style>
        <Style x:Key="VacationCompactCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VacationCompactCenteredTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VacationCompactCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VacationCompactDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="VacationCompactHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VacationCompactCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="5,2"/>
        </Style>
        <Style x:Key="VacationCompactRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PrimaryGradientBrush}" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PLANO DE FÉRIAS" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#20FFFFFF" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="ANO DO PLANO" Foreground="#DCEBFF" FontSize="8"/><TextBlock x:Name="HeaderYearText" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/></StackPanel>
                    </Border>
                    <Button Content="Manual SIPPES" Style="{StaticResource LightOnDarkButtonStyle}" Click="OpenSippesManual_Click" Margin="0,0,8,0"/>
                    <Button Content="Normas / resumo" Style="{StaticResource LightOnDarkButtonStyle}" Click="OpenVacationLegislation_Click" Margin="0,0,8,0"/>
                    <Button Content="Conferir publicações" Style="{StaticResource LightOnDarkButtonStyle}" Click="ReviewPublications_Click" Margin="0,0,8,0"/>
                    <Button Content="Relatório Excel" Style="{StaticResource LightOnDarkButtonStyle}" Click="ExportReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="94"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ano:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ComboBox x:Name="YearBox" Grid.Column="1" SelectionChanged="YearBox_SelectionChanged"/>
                <TextBlock Grid.Column="3" x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Content="Fechar" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="10,6,10,8" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Planejamento">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1*"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1.08*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="PERÍODOS DO ANO" Style="{StaticResource SectionTitleStyle}"/>
                                
                            </StackPanel>
                            <ListBox x:Name="PeriodsList" Grid.Row="1" Margin="0,8,0,8" SelectionChanged="PeriodsList_SelectionChanged" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullLabel}" Margin="2,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Nome do período" Style="{StaticResource SubtleTextStyle}"/>
                                <TextBox x:Name="PeriodNameBox" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Início" Style="{StaticResource SubtleTextStyle}"/>
                                        <DatePicker x:Name="PeriodStartPicker" SelectedDateFormat="Short" Margin="0,4,0,0" MinWidth="118" HorizontalContentAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fim" Style="{StaticResource SubtleTextStyle}"/>
                                        <DatePicker x:Name="PeriodEndPicker" SelectedDateFormat="Short" Margin="0,4,0,0" MinWidth="118" HorizontalContentAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Salvar período" Style="{StaticResource PrimaryButtonStyle}" Click="SavePeriod_Click" Margin="0,0,7,7"/>
                                    <Button Content="+ Especial" Style="{StaticResource SecondaryButtonStyle}" Click="NewSpecialPeriod_Click" Margin="0,0,7,7"/>
                                    <Button Content="Excluir especial" Style="{StaticResource DangerButtonStyle}" Click="DeleteSpecialPeriod_Click" Margin="0,0,0,7"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="MILITARES DISPONÍVEIS" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Grid.Column="1" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="7,3"><TextBlock x:Name="AvailableCountText" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/></Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,7">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="5"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="MilitarySearchBox" ToolTip="Nome, nome de guerra, CPF, PREC-CP, IDT ou P/G" TextChanged="MilitarySearchBox_TextChanged"/>
                                <ComboBox x:Name="RankFilterBox" Grid.Column="2" SelectionChanged="MilitaryFilter_Changed"/>
                                <CheckBox x:Name="AvailableOnlyCheck" Grid.Row="2" Content="Mostrar somente quem ainda tem dias disponíveis" IsChecked="True" Checked="MilitaryFilter_Changed" Unchecked="MilitaryFilter_Changed"/>
                                <ComboBox x:Name="SortModeBox" Grid.Row="2" Grid.Column="2" SelectionChanged="MilitaryFilter_Changed">
                                    <ComboBoxItem Content="Posto/Graduação"/><ComboBoxItem Content="Nome"/><ComboBoxItem Content="Ordem salva"/>
                                </ComboBox>
                            </Grid>
                            <DataGrid x:Name="MilitaryGrid" Grid.Row="2" Style="{StaticResource VacationCompactDataGridStyle}" ColumnHeaderStyle="{StaticResource VacationCompactHeaderStyle}" CellStyle="{StaticResource VacationCompactCellStyle}" RowStyle="{StaticResource VacationCompactRowStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="MilitaryGrid_MouseDoubleClick" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Adicionar selecionados ao período" Click="Allocate_Click"/>
                                        <MenuItem Header="Criar nota automática..." Tag="Available" Click="CreateAutomaticNote_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Selecionar todos os visíveis" Click="SelectAllMilitary_Click"/>
                                        <MenuItem Header="Limpar seleção" Click="ClearMilitarySelection_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Copiar selecionados" Click="CopySelectedMilitary_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="P/G" Binding="{Binding Rank}" Width="62" ElementStyle="{StaticResource VacationCompactCellTextStyle}"/>
                                    <DataGridTemplateColumn Header="Nome completo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Name}" WarName="{Binding WarName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Dias" Binding="{Binding DaysText}" Width="46" ElementStyle="{StaticResource VacationCompactCenteredTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="74"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dias:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <ComboBox x:Name="DaysBox" Grid.Column="1" SelectedIndex="2"><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/><ComboBoxItem Content="30"/></ComboBox>
                                <Button Grid.Column="2" Content="Criar nota" Tag="Available" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="CreateAutomaticNote_Click" Margin="8,0"/>
                                <Button Grid.Column="3" Content="Adicionar ao período →" Style="{StaticResource PrimaryButtonStyle}" Click="Allocate_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="MILITARES NO PERÍODO" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="SelectedPeriodCaption" Text="Selecione um período à esquerda." Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource InfoSoftBrush}" CornerRadius="10" Padding="7,3"><TextBlock x:Name="AllocatedCountText" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold"/></Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="AllocationSearchBox" ToolTip="Pesquisar nome, nome de guerra, CPF, PREC-CP ou P/G" TextChanged="AllocationSearchBox_TextChanged"/>
                                <ComboBox x:Name="AllocationStatusBox" Grid.Column="2" SelectionChanged="AllocationFilter_Changed">
                                    <ComboBoxItem Content="Todos"/><ComboBoxItem Content="Pendentes"/><ComboBoxItem Content="Pagos"/>
                                </ComboBox>
                            </Grid>
                            <DataGrid x:Name="AllocationsGrid" Grid.Row="2" Style="{StaticResource VacationCompactDataGridStyle}" ColumnHeaderStyle="{StaticResource VacationCompactHeaderStyle}" CellStyle="{StaticResource VacationCompactCellStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="AllocationsGrid_MouseDoubleClick" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown" RowHeight="30">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Abrir carteira / plano individual" Click="OpenIndividual_Click"/>
                                        <MenuItem Header="Criar nota automática..." Tag="Allocated" Click="CreateAutomaticNote_Click"/>
                                        <MenuItem Header="Mover / alterar dias" Click="MoveAllocation_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Marcar selecionados como pago" Click="MarkPaid_Click"/>
                                        <MenuItem Header="Marcar selecionados como pendente" Click="MarkUnpaid_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remover selecionados" Click="RemoveAllocation_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Selecionar todos" Click="SelectAllAllocations_Click"/>
                                        <MenuItem Header="Limpar seleção" Click="ClearAllocationsSelection_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Copiar selecionados" Click="CopySelectedAllocations_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#FFB71C1C"/>
                                        <Setter Property="Background" Value="#FFFFCDD2"/>
                                        <Setter Property="BorderBrush" Value="#FFD32F2F"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="MinHeight" Value="30"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                <Setter Property="Foreground" Value="#FF1B5E20"/>
                                                <Setter Property="Background" Value="#FFC8E6C9"/>
                                                <Setter Property="BorderBrush" Value="#FF2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="P/G" Binding="{Binding Rank}" Width="56" ElementStyle="{StaticResource VacationCompactCellTextStyle}"/>
                                    <DataGridTemplateColumn Header="Nome completo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Name}" WarName="{Binding WarName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Dias" Binding="{Binding Days}" Width="42" ElementStyle="{StaticResource VacationCompactCenteredTextStyle}"/>
                                    <DataGridTextColumn Header="Pgto" Binding="{Binding PaidText}" Width="66" ElementStyle="{StaticResource VacationCompactCenteredTextStyle}"/>
                                    <DataGridTextColumn Header="Aux. Alim." Binding="{Binding FoodAidText}" Width="106" ElementStyle="{StaticResource VacationCompactCellTextStyle}"/>
                                    <DataGridTextColumn Header="Registrado" Binding="{Binding PaidAtText}" Width="92" ElementStyle="{StaticResource VacationCompactCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="Criar nota automática" Tag="Allocated" Style="{StaticResource PrimaryButtonStyle}" Click="CreateAutomaticNote_Click" Margin="0,0,7,7"/>
                                <Button Content="Carteira / plano individual" Style="{StaticResource PrimaryButtonStyle}" Click="OpenIndividual_Click" Margin="0,0,7,7"/>
                                <Button Content="Mover / alterar dias" Style="{StaticResource SecondaryButtonStyle}" Click="MoveAllocation_Click" Margin="0,0,7,7"/>
                                <Button Content="Marcar pago" Style="{StaticResource SecondaryButtonStyle}" Click="MarkPaid_Click" Margin="0,0,7,7"/>
                                <Button Content="Marcar pendente" Style="{StaticResource SecondaryButtonStyle}" Click="MarkUnpaid_Click" Margin="0,0,7,7"/>
                                <Button Content="Remover" Style="{StaticResource DangerButtonStyle}" Click="RemoveAllocation_Click" Margin="0,0,0,7"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Boletins e SisBol">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="MODELOS" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox x:Name="ModelsList" Grid.Row="1" Margin="0,7,0,6" SelectionChanged="ModelsList_SelectionChanged" FontSize="11"/>
                            <WrapPanel Grid.Row="2"><Button Content="Novo" Style="{StaticResource SecondaryButtonStyle}" Click="NewModel_Click" Margin="0,0,6,6"/><Button Content="Renomear" Style="{StaticResource SecondaryButtonStyle}" Click="RenameModel_Click" Margin="0,0,6,6"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Click="DeleteModel_Click" Margin="0,0,0,6"/></WrapPanel>
                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="BOLETINS SALVOS" Style="{StaticResource SectionTitleStyle}"/>
                                <ListBox x:Name="SavedBulletinsList" Grid.Row="1" Margin="0,7,0,6" DisplayMemberPath="DisplayLabel" SelectionChanged="SavedBulletinsList_SelectionChanged" FontSize="11"/>
                                <WrapPanel Grid.Row="2"><Button Content="Salvar edição" Style="{StaticResource PrimaryButtonStyle}" Click="SaveBulletinEdition_Click" Margin="0,0,6,6"/><Button Content="Salvar como novo" Style="{StaticResource SecondaryButtonStyle}" Click="SaveBulletin_Click" Margin="0,0,6,6"/><Button Content="Renomear" Style="{StaticResource SecondaryButtonStyle}" Click="RenameBulletin_Click" Margin="0,0,6,6"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Click="DeleteBulletin_Click" Margin="0,0,0,6"/></WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Período do boletim" Style="{StaticResource SubtleTextStyle}"/><ComboBox x:Name="BulletinPeriodBox" DisplayMemberPath="FullLabel" SelectionChanged="BulletinPeriodBox_SelectionChanged"/></StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="BI de publicação" Style="{StaticResource SubtleTextStyle}"/>
                                    <DockPanel LastChildFill="True">
                                        <Button Content="BI salvo" Style="{StaticResource GhostButtonStyle}" Click="UseSavedBi_Click" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" FontSize="11" MinWidth="66" ToolTip="Escolher BI salvo e preencher referência completa."/>
                                        <TextBox x:Name="BulletinBiBox" ToolTip="Escolha um BI salvo ou digite manualmente. A referência completa usará automaticamente a OM ativa." TextChanged="BulletinBiBox_TextChanged"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Assunto específico" Style="{StaticResource SubtleTextStyle}"/><TextBox x:Name="SpecificSubjectBox"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Text="Código" Style="{StaticResource SubtleTextStyle}"/><TextBox x:Name="SpecificCodeBox"/></StackPanel>
                                <Button Grid.Column="7" Content="Campos" Style="{StaticResource SecondaryButtonStyle}" Click="FormFields_Click" Margin="6,14,0,0"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="MODELO EDITÁVEL" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox x:Name="ModelEditor" Tag="UiState.NoPersist" Grid.Row="1" SpellCheck.IsEnabled="True" Language="pt-BR" Margin="0,6,0,0" Padding="8,6" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" TextChanged="ModelEditor_TextChanged" FontFamily="Times New Roman" FontSize="12"/>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="PRÉVIA / BOLETIM SALVO" Style="{StaticResource SectionTitleStyle}"/><CheckBox x:Name="IncludeLateValuesCheck" Content="Usar valores individuais da Carteira de Férias" HorizontalAlignment="Right"/></Grid>
                                <RichTextBox x:Name="PreviewEditor" Tag="UiState.NoPersist" Grid.Row="1" SpellCheck.IsEnabled="True" Language="pt-BR" Margin="0,6,0,0" Padding="8,6" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" FontFamily="Times New Roman" FontSize="12" TextChanged="PreviewEditor_TextChanged"/>
                            </Grid>
                            <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Gerar prévia" Style="{StaticResource PrimaryButtonStyle}" Click="GeneratePreview_Click" Margin="0,0,8,0"/>
                                <Button Content="Copiar" Style="{StaticResource SecondaryButtonStyle}" Click="CopyPreview_Click" Margin="0,0,8,0"/>
                                <Button Content="Gerar Word" Style="{StaticResource SecondaryButtonStyle}" Click="ExportWord_Click" Margin="0,0,8,0"/>
                                <CheckBox x:Name="IncludeConsequencesCheck" Content="Incluir consequência" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="ConsequencesTextBox" Width="360" MinHeight="36" MaxHeight="66" Text="{x:Static services:SisbolTexts.VacationConsequencesText}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="6,4" Margin="0,0,8,0" ToolTip="Texto editável enviado ao campo Texto de Fechamento do SisBol."/>
                                <Button Content="Enviar ao SisBol" Style="{StaticResource PrimaryButtonStyle}" Click="SendSisbol_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Pronto." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SisbolStatusText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
