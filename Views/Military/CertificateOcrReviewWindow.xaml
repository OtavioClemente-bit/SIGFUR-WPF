<Window x:Class="SIGFUR.Wpf.Views.Military.CertificateOcrReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGFUR — Conferir leitura da certidão" Width="1040" Height="760" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PrimaryGradientBrush}" Padding="24,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONFERÊNCIA DA CERTIDÃO" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="HeaderSubtitle" Foreground="#DCEBFF" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#22FFFFFF" CornerRadius="14" Padding="14,8">
                    <TextBlock x:Name="ScoreText" Foreground="White" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="Dados identificados">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="WarningCard" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid x:Name="KeysGrid" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  MinRowHeight="42" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Campo" IsReadOnly="True" Width="235">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="6" VerticalAlignment="Center"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Chave" IsReadOnly="True" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Key}" TextWrapping="Wrap" Margin="6" VerticalAlignment="Center" FontFamily="Consolas"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Valor identificado — revise antes de salvar" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="7" VerticalAlignment="Center"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                                     AcceptsReturn="True" MinHeight="34" Padding="6" VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Clique duas vezes em qualquer valor para corrigir. Os campos adicionais podem ficar vazios. Ao confirmar, o documento e as chaves do Boletim serão atualizados juntos." Foreground="{DynamicResource MutedBrush}" Margin="2,9,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="Texto lido pelo OCR">
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="12">
                    <TextBox x:Name="RawTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Confira principalmente nome, CPF, nascimento, matrícula, filiação e endereço do cartório." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button Content="Abrir certidão original" Style="{StaticResource GhostButtonStyle}" Click="OpenOriginal_Click" Margin="0,0,7,0"/>
                        <Button Content="Copiar texto do OCR" Style="{StaticResource GhostButtonStyle}" Click="CopyRawText_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Confirmar e criar chaves" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
