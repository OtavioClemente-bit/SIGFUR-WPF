<Window x:Class="SIGFUR.Wpf.Views.Military.SippesPersonnelConferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        Title="SIGFUR — Conferência de Efetivo SIPPES" Width="1500" Height="880" MinWidth="1080" MinHeight="680"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Icon="/Assets/sigfur.ico" Background="{DynamicResource AppBackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONFERÊNCIA DE EFETIVO SIPPES" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Dados de Militar da Ativa, Espelho de Contracheque da OM e cruzamento com o SIGFUR" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionStatusText" Text="Carregando credenciais…" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CountText" Text="Nenhuma conferência executada" Style="{StaticResource SubtleTextStyle}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="10,8,10,6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Usuário / CPF SIPPES" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox x:Name="UserBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Senha" Style="{StaticResource CaptionTextStyle}"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Fluxo automático" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                    <TextBlock Text="Use a mesma sessão oculta do SIPPES. A aba Efetivo confere Dados MA. A aba Espelho OM gera o relatório completo do mês, cruza com os ativos e verifica os contracheques salvos." Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="5" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Salvar login protegido" Click="SaveCredentials_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Preparar sessão oculta" Click="PrepareSession_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Abrir portal manual" Click="OpenPortal_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="10,0,10,6">
            <TabItem Header="Dados MA / Efetivo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Resultado da conferência" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="SummaryText" Text="Clique em Conferir efetivo SIPPES. O SIGFUR só lê e compara; não altera cadastro e não mexe no SIPPES." TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="SippesCountPill" Text="SIPPES: 0" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="OkCountPill" Text="OK: 0" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="LicensedCountPill" Text="Lic./Transf.: 0" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="OutsideCountPill" Text="Fora: 0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="10" Padding="10,5"><TextBlock x:Name="MissingCountPill" Text="Ativo sem SIPPES: 0" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold"/></Border>
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Filtro:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="FilterBox" Width="230" SelectionChanged="Filter_Changed" SelectedIndex="0" Margin="0,0,10,0">
                                        <ComboBoxItem Content="Todos" Tag="ALL"/>
                                        <ComboBoxItem Content="Críticos" Tag="CRITICAL"/>
                                        <ComboBoxItem Content="Alertas/Atenção" Tag="ALERT"/>
                                        <ComboBoxItem Content="Ativos OK" Tag="ACTIVE_OK"/>
                                        <ComboBoxItem Content="Lic./Transf." Tag="LICENSED"/>
                                        <ComboBoxItem Content="Fora do SIGFUR" Tag="OUTSIDE"/>
                                        <ComboBoxItem Content="Ativo sem SIPPES" Tag="MISSING"/>
                                        <ComboBoxItem Content="Pagamento normal" Tag="PAY_NORMAL"/>
                                        <ComboBoxItem Content="Pagamento suspenso" Tag="PAY_SUSPENDED"/>
                                        <ComboBoxItem Content="Pagamento diferente" Tag="PAY_OTHER"/>
                                        <ComboBoxItem Content="Situação PDF não localizada" Tag="PAY_NOT_FOUND"/>
                                        <ComboBoxItem Content="Não ativo + pagamento normal" Tag="NOT_ACTIVE_PAY_NORMAL"/>
                                    </ComboBox>
                                    <TextBlock Text="Busca:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="SearchBox" Width="260" TextChanged="Filter_Changed" ToolTip="Busca por nome, CPF, Idt, situação, pagamento, OM ou conferência"/>
                                </WrapPanel>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="3" Width="690" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Content="Conferir + baixar PDFs" Click="Run_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Conferir só tabela" Click="RunTableOnly_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Ler PDFs salvos" Click="LoadSavedPdfs_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Selecionar PDFs…" Click="SelectPdfs_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir pasta PDFs" Click="OpenPdfFolder_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Carregar última conferência" Click="LoadLastConference_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Ler tabela aberta agora" Click="CaptureOpen_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Exportar CSV" Click="ExportCsv_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Relatório crítico" Click="ExportCriticalReport_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Enviar fora → Pessoas de fora" Click="SendOutside_Click" MinHeight="40" Margin="4"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Limpar resultado" Click="Clear_Click" MinHeight="40" Margin="4"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True" FrozenColumnCount="2" MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                                  RowHeight="32" ColumnHeaderHeight="34" FontSize="12" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="CRÍTICO"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="ALERTA"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="ATENÇÃO"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="1.05*" MinWidth="190"/>
                                <DataGridTextColumn Header="Gravidade" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="P/G" Binding="{Binding DisplayRank}" Width="115"/>
                                <DataGridTemplateColumn Header="Nome" Width="1.8*" MinWidth="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="4,2" HorizontalAlignment="Stretch" Cursor="Hand" MouseLeftButtonUp="OpenPdfFromName_MouseLeftButtonUp" ToolTip="Clique para abrir o PDF Dados MA salvo deste militar">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextDecorations="Underline" Foreground="{DynamicResource PrimaryDarkBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CPF" Binding="{Binding DisplayCpf}" Width="118"/>
                                <DataGridTextColumn Header="Idt/Cadastro" Binding="{Binding DisplayMilitaryId}" Width="110"/>
                                <DataGridTextColumn Header="OM SIPPES" Binding="{Binding SippesOm}" Width="120"/>
                                <DataGridTextColumn Header="Situação PDF" Binding="{Binding DisplayPaymentStatus}" Width="145"/>
                                <DataGridTextColumn Header="Alerta pagamento" Binding="{Binding PaymentAlert}" Width="1.1*" MinWidth="170"/>
                                <DataGridTextColumn Header="PDF" Binding="{Binding ReportDownloadStatus}" Width="140"/>
                                <DataGridTextColumn Header="Cadastro SIGFUR" Binding="{Binding SigfurSource}" Width="145"/>
                                <DataGridTextColumn Header="Conferência" Binding="{Binding MatchKind}" Width="1.25*" MinWidth="210"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Espelho Contracheque OM">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Espelho de Contracheque da OM" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="MirrorSummaryText" Text="Modo manual assistido: escolha mês/ano e clique em Abrir manual + aguardar OK. O SIGFUR abre o SIPPES visível e para. Você faz o fluxo manualmente até chegar no relatório detalhado com nomes, dados e valores. Quando estiver tudo carregado, volte no SIGFUR e clique OK na mensagem; ele oculta o navegador, salva HTML/TXT e cruza com ativos e contracheques salvos. Tudo fica salvo por mês, para você carregar e bater novamente depois." TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"/>
                                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,8,0,0">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="Acompanhamento ao vivo — agora o SIPPES fica na sua mão até você clicar OK para o SIGFUR ler" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MirrorLiveLogBox" MinHeight="74" MaxHeight="92" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="Pronto. Clique em Abrir manual + aguardar OK, faça tudo no SIPPES manualmente e depois confirme no SIGFUR para ler os dados."/>
                                    </DockPanel>
                                </Border>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="MirrorCountPill" Text="Espelho: 0" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="MirrorOutsidePill" Text="Fora dos ativos: 0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,8,0"><TextBlock x:Name="MirrorSavedPill" Text="Contracheque salvo OK: 0" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/></Border>
                                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="10,5"><TextBlock x:Name="MirrorMissingPaystubPill" Text="Sem salvo: 0" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/></Border>
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mês:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="MirrorMonthBox" Width="130" SelectedIndex="0" Margin="0,0,10,0">
                                        <ComboBoxItem Content="Janeiro" Tag="1"/>
                                        <ComboBoxItem Content="Fevereiro" Tag="2"/>
                                        <ComboBoxItem Content="Março" Tag="3"/>
                                        <ComboBoxItem Content="Abril" Tag="4"/>
                                        <ComboBoxItem Content="Maio" Tag="5"/>
                                        <ComboBoxItem Content="Junho" Tag="6"/>
                                        <ComboBoxItem Content="Julho" Tag="7"/>
                                        <ComboBoxItem Content="Agosto" Tag="8"/>
                                        <ComboBoxItem Content="Setembro" Tag="9"/>
                                        <ComboBoxItem Content="Outubro" Tag="10"/>
                                        <ComboBoxItem Content="Novembro" Tag="11"/>
                                        <ComboBoxItem Content="Dezembro" Tag="12"/>
                                    </ComboBox>
                                    <TextBlock Text="Ano:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="MirrorYearBox" Width="70" Margin="0,0,14,0"/>
                                    <TextBlock Text="Filtro:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="MirrorFilterBox" Width="210" SelectionChanged="MirrorFilter_Changed" SelectedIndex="0" Margin="0,0,10,0">
                                        <ComboBoxItem Content="Todos" Tag="ALL"/>
                                        <ComboBoxItem Content="Fora dos ativos" Tag="OUTSIDE"/>
                                        <ComboBoxItem Content="Ativos conferidos" Tag="ACTIVE"/>
                                        <ComboBoxItem Content="Sem contracheque salvo" Tag="MISSING_PAYSTUB"/>
                                        <ComboBoxItem Content="Contracheque salvo OK" Tag="PAYSTUB_OK"/>
                                        <ComboBoxItem Content="Ativo sem aparecer no espelho" Tag="ACTIVE_MISSING"/>
                                    </ComboBox>
                                    <TextBlock Text="Busca:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="MirrorSearchBox" Width="260" TextChanged="MirrorFilter_Changed" ToolTip="Busca por nome, CPF, Idt, P/G, situação ou contracheque salvo"/>
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Text="Dica: clique no cabeçalho para ordenar; arraste as colunas para reorganizar e as divisórias para ajustar a largura. O SIGFUR salva automaticamente essa organização."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="2" Width="460" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button x:Name="MirrorRunButton" Style="{StaticResource PrimaryButtonStyle}" Content="Abrir manual + aguardar OK" Click="GenerateMirror_Click" MinHeight="42" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Ler tela aberta agora" Click="ReadOpenMirror_Click" MinHeight="42" Margin="4"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Bater rubricas/valores" Click="CompareMirrorValues_Click" MinHeight="42" Margin="4" ToolTip="Compara as rubricas e valores do Espelho OM salvo com os contracheques PDF salvos do mês."/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Carregar última" Click="LoadLastMirror_Click" MinHeight="42" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Carregar mês" Click="LoadMirrorMonth_Click" MinHeight="42" Margin="4" ToolTip="Carrega a conferência salva do mês/ano selecionado. Se ainda não existir cache, tenta ler o HTML salvo mais recente daquele mês."/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir pasta espelho" Click="OpenMirrorFolder_Click" MinHeight="42" Margin="4"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Exportar CSV" Click="ExportMirrorCsv_Click" MinHeight="42" Margin="4"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Limpar espelho" Click="ClearMirror_Click" MinHeight="42" Margin="4"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid x:Name="MirrorGridCompact" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                                  FrozenColumnCount="0" MouseDoubleClick="MirrorGrid_MouseDoubleClick"
                                  RowHeight="40" ColumnHeaderHeight="38" FontSize="11" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" AlternationCount="2"
                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Padding" Value="7,5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="Clique para ordenar ou arraste para mudar a posição"/>
                                </Style>
                                <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Margin="12,4,12,10" Padding="12" CornerRadius="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DisplayValueCheckStatus}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="Rubricas e valores no Espelho OM" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding DisplayMirrorRubricsText, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" Padding="10" FontFamily="Consolas" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" MaxHeight="260"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="Rubricas e valores no contracheque PDF" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding DisplayPaystubRubricsText, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" Padding="10" FontFamily="Consolas" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" MaxHeight="260"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="CRÍTICO"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="ALERTA"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="ATENÇÃO"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="170"/>
                                <DataGridTextColumn Header="Nível" Binding="{Binding Severity}" Width="65"/>
                                <DataGridTextColumn Header="P/G" Binding="{Binding ShortDisplayRank}" Width="70" SortMemberPath="DisplayRank"/>
                                <DataGridTemplateColumn Header="Militar" Width="210" SortMemberPath="DisplayName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:HighlightedNameTextBlock FullName="{Binding DisplayName}" WarName="{Binding DisplayWarName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CPF" Binding="{Binding DisplayCpf}" Width="105"/>
                                <DataGridTextColumn Header="Idt" Binding="{Binding DisplayMilitaryId}" Width="80"/>
                                <DataGridTextColumn Header="PREC" Binding="{Binding SippesPrecCp}" Width="75"/>
                                <DataGridTextColumn Header="SIPPES" Binding="{Binding PaymentStatus}" Width="95"/>
                                <DataGridTextColumn Header="Líquido" Binding="{Binding NetValue}" Width="80"/>
                                <DataGridTemplateColumn Header="Conferência" Width="140" SortMemberPath="ValueCheckStatus">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" CornerRadius="6" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding ValueCheckCompact}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding DisplayValueCheckStatus}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Espelho" Width="115" SortMemberPath="MirrorRubricsText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" CornerRadius="6" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding MirrorRubricsCompact}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding DisplayMirrorRubricsText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PDF" Width="115" SortMemberPath="PaystubRubricsText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" CornerRadius="6" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding PaystubRubricsCompact}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding DisplayPaystubRubricsText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Abrir" Width="120" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="PDF" Click="OpenMirrorPaystub_Click" Width="48" Height="26" Margin="0,0,4,0" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Abrir o contracheque PDF salvo do mês selecionado"/>
                                                <Button Content="Ficha" Click="OpenMirrorSippesFicha_Click" Width="52" Height="26" Style="{StaticResource GhostButtonStyle}" ToolTip="Abrir a ficha/dados do militar no SIPPES"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Pronto." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" IsIndeterminate="True" Visibility="Collapsed" Height="8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButtonStyle}" Content="Cancelar" Click="Cancel_Click" MinWidth="90" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Fechar" Click="Close_Click" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
