<Window x:Class="SIGFUR.Wpf.Views.OrganizationImagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher imagem institucional" Width="1160" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IMAGENS ENCONTRADAS" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="SubtitleText" Text="Confira a origem antes de vincular a imagem ao perfil operacional." Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" Margin="0,4,12,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <ListBox x:Name="CandidateList" BorderThickness="0" Background="Transparent" SelectionMode="Single" MouseDoubleClick="CandidateList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SelectionBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="3"/>
                                            <Setter TargetName="SelectionBorder" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="244" Height="260" Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" ClipToBounds="True">
                                <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,9,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="7" Padding="7,3">
                                    <TextBlock Text="{Binding SourceDisplay}" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ResolutionText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                            <TextBlock Grid.Row="3" Text="Duplo clique para usar" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="A imagem será copiada para o cache local do SIGFUR e continuará disponível sem internet." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,360,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abrir origem" Style="{StaticResource GhostButtonStyle}" Click="OpenSource_Click" Margin="0,0,8,0"/>
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="USAR IMAGEM SELECIONADA" Style="{StaticResource PrimaryButtonStyle}" Click="Use_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
