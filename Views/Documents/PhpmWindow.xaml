<Window x:Class="SIGFUR.Wpf.Views.Documents.PhpmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        Title="PHPM — Central de Documentos" Width="1540" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ProfessionalGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="AlternationCount" Value="2"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style x:Key="FieldCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallMetricStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PrimaryDarkBrush}" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PHPM — DOCUMENTOS" Foreground="White" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Seleção, preenchimento orientado, lote e geração em um fluxo único"
                               Foreground="{DynamicResource TextOnPrimaryMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SmallMetricStyle}" Background="#26FFFFFF" BorderBrush="#45FFFFFF">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Modelos  " Foreground="{DynamicResource TextOnPrimaryMutedBrush}"/><TextBlock x:Name="TemplateMetric" Text="0" Foreground="White" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource SmallMetricStyle}" Background="#26FFFFFF" BorderBrush="#45FFFFFF">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="No lote  " Foreground="{DynamicResource TextOnPrimaryMutedBrush}"/><TextBlock x:Name="BatchMetric" Text="0" Foreground="White" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource SmallMetricStyle}" Background="#26FFFFFF" BorderBrush="#45FFFFFF">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Gerados  " Foreground="{DynamicResource TextOnPrimaryMutedBrush}"/><TextBlock x:Name="GeneratedMetric" Text="0" Foreground="White" FontWeight="Bold"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Documentos" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Escolha o modelo para iniciar" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                        <Button Grid.Column="1" Content="+ Novo" Style="{StaticResource SecondaryButtonStyle}" Click="AddTemplate_Click"/>
                    </Grid>
                    <TextBox x:Name="TemplateSearchBox" Grid.Row="1" Margin="0,11,0,9" TextChanged="TemplateSearchBox_TextChanged" ToolTip="Pesquisar documento"/>
                    <ListBox x:Name="TemplateList" Grid.Row="2" SelectionChanged="TemplateList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="7,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="  •  "/><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Vincular ou substituir arquivo" Click="AttachTemplate_Click"/><MenuItem Header="Reexaminar campos" Click="RescanTemplate_Click"/><MenuItem Header="Abrir modelo" Click="OpenTemplate_Click"/><Separator/><MenuItem Header="Remover modelo personalizado" Click="RemoveTemplate_Click"/></ContextMenu></ListBox.ContextMenu>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="Vincular arquivo ao selecionado" Style="{StaticResource SecondaryButtonStyle}" Click="AttachTemplate_Click"/>
                        <Button Content="Abrir pasta de modelos" Style="{StaticResource GhostButtonStyle}" Margin="0,7,0,0" Click="OpenTemplatesFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TemplateTitleText" Text="Selecione um documento" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="TemplateDescriptionText" Text="Escolha um modelo na coluna ao lado." Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource InfoSoftBrush}" CornerRadius="9" Padding="11,7" VerticalAlignment="Center">
                                <TextBlock x:Name="TemplateStatusText" Text="Nenhum modelo" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" x:Name="WorkflowTabs">
                        <TabItem Header="1  Pessoas e lote">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="Militares disponíveis" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Selecione uma ou várias linhas. Duplo clique adiciona e abre o preenchimento." Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                                    <TextBox x:Name="MilitarySearchBox" Grid.Row="1" Margin="0,10,0,8" TextChanged="MilitarySearchBox_TextChanged" ToolTip="Nome, nome de guerra, CPF, PREC-CP, identidade ou P/G"/>
                                    <DataGrid x:Name="MilitaryGrid" Grid.Row="2" Style="{StaticResource ProfessionalGridStyle}" SelectionMode="Extended"
                                              SelectionChanged="MilitaryGrid_SelectionChanged" MouseDoubleClick="MilitaryGrid_MouseDoubleClick">
                                        <DataGrid.Columns><DataGridTextColumn Header="P/G" Binding="{Binding ShortRank}" Width="72"/><DataGridTemplateColumn Header="Nome completo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Name}" WarName="{Binding WarName}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PREC-CP" Binding="{Binding PrecCp}" Width="100"/><DataGridTextColumn Header="CPF" Binding="{Binding FormattedCpf}" Width="118"/></DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Grid.Row="3" Margin="0,9,0,0">
                                        <Button Content="Adicionar selecionados" Style="{StaticResource PrimaryButtonStyle}" Click="AddSelectedToBatch_Click" Margin="0,0,7,0"/>
                                        <Button Content="Adicionar todos os filtrados" Style="{StaticResource SecondaryButtonStyle}" Click="AddFilteredToBatch_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lote de geração" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Clique em uma pessoa para preencher os dados dela." Style="{StaticResource CaptionTextStyle}"/></StackPanel><Button Grid.Column="1" Content="Limpar lote" Style="{StaticResource GhostButtonStyle}" Click="ClearBatch_Click"/></Grid>
                                    <DataGrid x:Name="BatchGrid" Grid.Row="1" Style="{StaticResource ProfessionalGridStyle}" Margin="0,10,0,0" SelectionChanged="BatchGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="P/G" Binding="{Binding ShortRank}" Width="68"/>
                                            <DataGridTemplateColumn Header="Militar" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Name}" WarName="{Binding WarName}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Situação" Binding="{Binding StatusText}" Width="112"/>
                                            <DataGridTemplateColumn Header="" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remover" Style="{StaticResource GhostButtonStyle}" Padding="7,3" CommandParameter="{Binding}" Click="RemoveBatchItem_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                        <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Remover selecionado do lote" Click="RemoveBatch_Click"/><MenuItem Header="Copiar identificação" Click="CopyBatchName_Click"/></ContextMenu></DataGrid.ContextMenu>
                                    </DataGrid>
                                    <Button Grid.Row="2" Content="Preencher dados do selecionado" Style="{StaticResource PrimaryButtonStyle}" Click="OpenBatchFields_Click" Margin="0,9,0,0" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="2  Preenchimento">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Preenchimento orientado" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="EditingMilitaryText" Text="Selecione um militar na primeira etapa." FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SmallMetricStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="Obrigatórios  "/><TextBlock x:Name="RequiredMetric" Text="0" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Style="{StaticResource SmallMetricStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="Pendentes  "/><TextBlock x:Name="MissingMetric" Text="0" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold"/></StackPanel></Border>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Padding="10,6" Margin="0,10,0,8">
                                    <TextBlock x:Name="FieldsGuidanceText" Text="Campos do cadastro são preenchidos automaticamente. Os destacados precisam ser informados antes da geração." TextWrapping="Wrap" Foreground="{DynamicResource InfoBrush}"/>
                                </Border>
                                <Border Grid.Row="2" x:Name="DynamicFormPanel" Visibility="Collapsed"
                                        Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Quem será incluído neste documento?" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Escolha primeiro as quantidades. O SIGFUR abrirá somente os formulários necessários."
                                                   Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,9"/>
                                        <WrapPanel x:Name="BeneficiaryConfigurationPanel" Visibility="Collapsed">
                                            <StackPanel Width="148" Margin="0,0,10,5"><TextBlock Text="Cônjuge" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="SpouseBox" SelectionChanged="DynamicFormConfiguration_Changed"/></StackPanel>
                                            <StackPanel Width="148" Margin="0,0,10,5"><TextBlock Text="Filhos / enteados" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="ChildrenCountBox" SelectionChanged="DynamicFormConfiguration_Changed"/></StackPanel>
                                            <StackPanel Width="165" Margin="0,0,10,5"><TextBlock Text="Companheiro(a)" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="CompanionBox" SelectionChanged="DynamicFormConfiguration_Changed"/></StackPanel>
                                            <StackPanel Width="170" Margin="0,0,10,5"><TextBlock Text="Outros beneficiários" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="OtherBeneficiariesCountBox" SelectionChanged="DynamicFormConfiguration_Changed"/></StackPanel>
                                            <StackPanel Width="165" Margin="0,0,0,5"><TextBlock Text="Pessoa designada" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="DesignatedPersonBox" SelectionChanged="DynamicFormConfiguration_Changed"/></StackPanel>
                                        </WrapPanel>
                                        <WrapPanel x:Name="DependentConfigurationPanel" Visibility="Collapsed">
                                            <StackPanel Width="220"><TextBlock Text="Quantidade de dependentes" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="DependentsCountBox" SelectionChanged="DynamicFormConfiguration_Changed"/></StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ListBox Grid.Row="3" x:Name="FieldsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="{DynamicResource PrimarySurfaceBrush}" CornerRadius="7" Padding="10,6" Margin="0,10,0,7"><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="IsTabStop" Value="False"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FieldCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text=" *" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRequired}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2">
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSuggestions}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                                        <ComboBox ItemsSource="{Binding Suggestions}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" ToolTip="{Binding Hint}"><ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSuggestions}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsOfficialPublicationReference}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                                                        <ComboBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="False" IsTextSearchEnabled="True" MaxDropDownHeight="380" ToolTip="{Binding Hint}">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasSuggestions}" Value="True"/>
                                                                                <Condition Binding="{Binding IsOfficialPublicationReference}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>
                                                    </Grid>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Source}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                                                        <TextBlock Text="{Binding Hint}" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding ValidationMessage}" FontSize="9" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"><Button Content="Reaplicar dados do cadastro" Style="{StaticResource SecondaryButtonStyle}" Click="Autofill_Click" Margin="0,0,7,0"/><Button Content="Limpar campos manuais" Style="{StaticResource GhostButtonStyle}" Click="ClearManualFields_Click"/></StackPanel>
                                    <Button Grid.Column="1" Content="Conferir e gerar" Style="{StaticResource PrimaryButtonStyle}" Click="OpenGeneration_Click" MinWidth="145"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="3  Gerar e histórico">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Configuração da saída" Style="{StaticResource SectionTitleStyle}"/>
                                            <StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="Nome do arquivo" Style="{StaticResource CaptionTextStyle}"/><TextBox x:Name="OutputNameBox"/></StackPanel>
                                            <Grid Grid.Row="2" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Formato final" Style="{StaticResource CaptionTextStyle}"/><ComboBox x:Name="OutputFormatBox" SelectedIndex="0"><ComboBoxItem Content="Original"/><ComboBoxItem Content="DOCX"/><ComboBoxItem Content="PDF"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Conversor" Style="{StaticResource CaptionTextStyle}"/><TextBlock x:Name="LibreOfficeStatusText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid>
                                            <WrapPanel Grid.Row="3" Margin="0,10,0,0"><CheckBox x:Name="OpenAfterGenerateBox" Content="Abrir depois de gerar" IsChecked="True" Margin="0,0,14,6"/><CheckBox x:Name="KeepIntermediateBox" Content="Manter intermediário" Margin="0,0,14,6"/><CheckBox x:Name="AddToPrintQueueBox" Content="Adicionar à fila" Margin="0,0,14,6"/><CheckBox x:Name="SaveCadastroBox" Content="Atualizar cadastro" Margin="0,0,14,6"/></WrapPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Conferência" Style="{StaticResource SectionTitleStyle}"/><TextBlock Grid.Row="1" x:Name="GenerationSummaryText" Text="Selecione um documento e um militar." TextWrapping="Wrap" Margin="0,10,0,10"/><WrapPanel Grid.Row="2"><Button Content="Gerar militar em edição" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateSelected_Click" Margin="0,0,7,7"/><Button Content="Gerar lote pronto" Style="{StaticResource SecondaryButtonStyle}" Click="GenerateBatch_Click" Margin="0,0,7,7"/><Button Content="Fila de impressão" Style="{StaticResource GhostButtonStyle}" Click="OpenPrintQueue_Click" Margin="0,0,7,7"/><Button Content="Abrir pasta" Style="{StaticResource GhostButtonStyle}" Click="OpenOutputFolder_Click" Margin="0,0,7,7"/></WrapPanel></Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Histórico de geração" Style="{StaticResource SectionTitleStyle}" Margin="0,13,0,7"/>
                                <DataGrid Grid.Row="2" x:Name="HistoryGrid" Style="{StaticResource ProfessionalGridStyle}" MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                                    <DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding GeneratedAtText}" Width="130"/><DataGridTextColumn Header="Documento" Binding="{Binding TemplateTitle}" Width="220"/><DataGridTextColumn Header="Militar" Binding="{Binding MilitaryName}" Width="*"/><DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="1.2*"/><DataGridTextColumn Header="Formato" Binding="{Binding OutputFormat}" Width="76"/><DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="76"/></DataGrid.Columns>
                                    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Abrir arquivo" Click="OpenHistory_Click"/><MenuItem Header="Abrir pasta" Click="OpenHistoryFolder_Click"/><MenuItem Header="Adicionar à fila" Click="AddHistoryToQueue_Click"/><MenuItem Header="Copiar caminho" Click="CopyHistoryPath_Click"/></ContextMenu></DataGrid.ContextMenu>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Selecione um documento para iniciar." VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Ctrl+F pesquisa militares  •  Duplo clique adiciona ao lote" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/></Grid>
        </Border>
    </Grid>
</Window>
