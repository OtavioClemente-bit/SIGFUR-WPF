<Window x:Class="SIGFUR.Wpf.Views.Documents.LegislationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Central Técnica Offline — Legislação e Manual do SIPPES"
        Width="1540" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/sigfur.ico"
        KeyDown="Window_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="20" Background="{DynamicResource PrimarySurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CENTRAL TÉCNICA OFFLINE" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryDarkerBrush}"/>
                    <TextBlock Text="Manual do SIPPES, portarias, decretos e leis já incluídos no SIGFUR. Pesquise e leia por página sem internet e sem precisar guardar PDFs separadamente."
                               Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="100% OFFLINE" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="12" Padding="10,4" Margin="6,0,0,0">
                            <TextBlock Text="CONTEÚDO PRÉ-INSTALADO" Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MetricCardStyle}" MinWidth="145" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DOCUMENTOS" Style="{StaticResource MetricCaptionStyle}"/>
                            <TextBlock x:Name="DocumentsMetric" Text="0" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}" MinWidth="145" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="PÁGINAS" Style="{StaticResource MetricCaptionStyle}"/>
                            <TextBlock x:Name="PagesMetric" Text="0" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Height="42" FontSize="15" VerticalContentAlignment="Center" Padding="12,0"
                         ToolTip="Digite uma pergunta, assunto, rubrica, artigo ou número de norma. Ctrl+F para focar."
                         KeyDown="SearchBox_KeyDown"/>
                <ComboBox x:Name="ScopeBox" Grid.Column="1" Height="42" Margin="10,0,0,0" VerticalContentAlignment="Center"
                          SelectedIndex="0" ToolTip="Escolha onde pesquisar">
                    <ComboBoxItem Content="Toda a biblioteca" Tag="All"/>
                    <ComboBoxItem Content="Somente Manual SIPPES" Tag="ManualSippes"/>
                    <ComboBoxItem Content="Somente normas e portarias" Tag="LegalNorms"/>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="Pesquisar" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10" Click="Search_Click"/>
                    <Button Content="Resumo offline" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Padding="18,10" Click="Answer_Click" ToolTip="Monta uma síntese apenas com as fontes locais e cita as páginas"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <Button Content="Manual do SIPPES" Tag="__manual__" Style="{StaticResource SecondaryButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Adicional de habilitação" Tag="adicional de habilitação curso SICAPEx" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Auxílio-Transporte" Tag="auxílio-transporte NR0095 AR0095 DR0095" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Férias" Tag="férias adicional de férias indenização AR0092 AR0094" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Exercícios anteriores" Tag="exercícios anteriores saque SIPPES" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Pré-escolar" Tag="assistência pré-escolar dependente" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Pensão" Tag="pensão alimentícia desconto em folha" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                    <Button Content="Grat. Representação" Tag="gratificação de representação" Style="{StaticResource GhostButtonStyle}" Click="QuickTopic_Click" Margin="0,0,7,6"/>
                </WrapPanel>

                <Expander Grid.Row="2" Grid.ColumnSpan="3" Header="Manutenção e importação de documentos próprios" Margin="0,3,0,0">
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Importar arquivos" Style="{StaticResource GhostButtonStyle}" Click="ImportFiles_Click" Margin="0,0,8,6"/>
                        <Button Content="Importar ZIP" Style="{StaticResource GhostButtonStyle}" Click="ImportZip_Click" Margin="0,0,8,6"/>
                        <Button Content="Importar pasta" Style="{StaticResource GhostButtonStyle}" Click="ImportFolder_Click" Margin="0,0,8,6"/>
                        <Button Content="Atualizar índice" Style="{StaticResource GhostButtonStyle}" Click="Index_Click" Margin="0,0,8,6"/>
                        <Button Content="Reindexar tudo" Style="{StaticResource GhostButtonStyle}" Click="ForceIndex_Click" Margin="0,0,8,6"/>
                        <Button Content="Abrir pasta de importados" Style="{StaticResource GhostButtonStyle}" Click="OpenLibrary_Click" Margin="0,0,8,6"/>
                        <TextBlock x:Name="IndexStatusText" Margin="10,0,0,6" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" Text="Preparando biblioteca…"/>
                    </WrapPanel>
                </Expander>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="BIBLIOTECA INSTALADA" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="BuiltInCountText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox x:Name="DocumentFilterBox" Grid.Row="1" Margin="0,10,0,10" Height="34"
                             VerticalContentAlignment="Center" Padding="8,0"
                             TextChanged="DocumentFilterBox_TextChanged"
                             ToolTip="Filtrar por título, tipo ou assunto"/>
                    <ListBox x:Name="DocumentList" Grid.Row="2"
                             SelectionChanged="DocumentList_SelectionChanged"
                             MouseDoubleClick="DocumentList_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10.5" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding DetailsText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ler dentro do SIGFUR" Click="ReadSelectedDocument_Click"/>
                                <MenuItem Header="Abrir PDF original" Click="OpenSelectedDocument_Click"/>
                                <MenuItem Header="Abrir pasta do documento" Click="OpenSelectedDocumentFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="Copiar caminho" Click="CopyDocumentPath_Click"/>
                                <MenuItem Header="Remover documento importado" Click="DeleteDocument_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="RESULTADOS POR RELEVÂNCIA" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="ResultCountText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="1" Margin="0,10,0,10"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"
                              MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ler esta página" Click="ReadSelectedResult_Click"/>
                                <MenuItem Header="Abrir PDF original" Click="OpenSelectedResult_Click"/>
                                <Separator/>
                                <MenuItem Header="Copiar referência" Click="CopyReference_Click"/>
                                <MenuItem Header="Copiar trecho" Click="CopySnippet_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assunto" Binding="{Binding Category}" Width="145"/>
                            <DataGridTextColumn Header="Documento" Binding="{Binding Title}" Width="190"/>
                            <DataGridTextColumn Header="Pág." Binding="{Binding Page}" Width="52"/>
                            <DataGridTextColumn Header="Trecho relevante" Binding="{Binding Snippet}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copiar referência" Style="{StaticResource GhostButtonStyle}" Click="CopyReference_Click"/>
                        <Button Content="Ler página selecionada" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="ReadSelectedResult_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="LEITOR INTERNO" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock x:Name="ReferenceText" Grid.Row="1" Margin="0,8,0,8"
                               Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PreviousPageButton" Content="← Página anterior" Style="{StaticResource GhostButtonStyle}"
                                Click="PreviousPage_Click" IsEnabled="False"/>
                        <TextBlock x:Name="PagePositionText" Grid.Column="1" Text="Nenhuma página aberta"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <Button x:Name="NextPageButton" Grid.Column="2" Content="Próxima página →" Style="{StaticResource GhostButtonStyle}"
                                Click="NextPage_Click" IsEnabled="False"/>
                    </Grid>
                    <TextBox x:Name="PreviewBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" Padding="14"
                             FontFamily="Segoe UI" FontSize="13">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copiar seleção" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Selecionar tudo" Command="ApplicationCommands.SelectAll"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Documento inteiro" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="ReadWholeDocument_Click"/>
                        <Button Content="Exportar texto" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Click="ExportPreview_Click"/>
                        <Button Content="Copiar" Style="{StaticResource SecondaryButtonStyle}" Click="CopyPreview_Click"/>
                        <Button Content="Abrir PDF original" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="OpenCurrentSource_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8"
                Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8">
            <TextBlock x:Name="FooterStatusText"
                       Text="A consulta funciona inteiramente offline. Para decisões de pagamento, confira a página citada e a vigência da norma."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
