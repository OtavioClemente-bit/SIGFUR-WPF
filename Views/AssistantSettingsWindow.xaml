<Window x:Class="SIGFUR.Wpf.Views.AssistantSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Assistente SIGFUR" Width="860" Height="820" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner" Icon="/Assets/sigfur.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Background="{DynamicResource PrimarySurfaceBrush}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONFIGURAÇÃO DO ASSISTENTE" Style="{StaticResource PageTitleStyle}" FontSize="21"/>
                    <TextBlock Text="IA por API, fontes verificáveis e acompanhamento operacional." Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="ApiStatusBadge" CornerRadius="12" Padding="12,7" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="ApiStatusText" Text="Verificando chave..." FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Provedor e chave da IA" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Provedor" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
                        <ComboBox x:Name="ProviderBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,10" SelectionChanged="Provider_SelectionChanged">
                            <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                            <ComboBoxItem Content="DeepSeek" Tag="DeepSeek"/>
                        </ComboBox>
                        <TextBlock Text="A chave não é gravada no arquivo de configuração. Ela fica no Gerenciador de Credenciais do Windows deste computador. Você pode salvá-la mesmo se o teste da intranet falhar." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Height="38" Padding="10,7" ToolTip="Cole uma nova chave para salvar ou testar"/>
                            <Button Grid.Column="1" Content="Salvar chave neste PC" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="SaveKey_Click"/>
                            <Button x:Name="TestButton" Grid.Column="2" Content="Testar conexão" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="Test_Click"/>
                            <Button Grid.Column="3" Content="Remover chave" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" Click="DeleteKey_Click"/>
                        </Grid>
                        <TextBlock x:Name="TestStatusText" Style="{StaticResource CaptionTextStyle}" Margin="0,9,0,0"/>
                        <Button x:Name="DiagnosticButton" Content="Executar diagnóstico detalhado de rede" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="Diagnostic_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                             <TextBlock Text="Modelo" Style="{StaticResource CaptionTextStyle}"/>
                             <ComboBox x:Name="ModelBox" IsEditable="True" Margin="0,4,0,12"/>
                             <TextBlock Text="gpt-5.6-luna é o padrão recomendado do SIGFUR para precisão com baixo custo." Style="{StaticResource CaptionTextStyle}" Margin="0,-7,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="Raciocínio" Style="{StaticResource CaptionTextStyle}"/>
                            <ComboBox x:Name="ReasoningBox" Margin="0,4,0,12">
                                <ComboBoxItem Content="none" Tag="none"/>
                                <ComboBoxItem Content="low" Tag="low"/>
                                <ComboBoxItem Content="medium" Tag="medium"/>
                                 <ComboBoxItem Content="high" Tag="high"/>
                                 <ComboBoxItem Content="xhigh" Tag="xhigh"/>
                                 <ComboBoxItem Content="max" Tag="max"/>
                            </ComboBox>
                            <TextBlock Text="Limite máximo da resposta (tokens)" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBox x:Name="MaxTokensBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Limite interno mensal (R$)" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBox x:Name="BudgetBox" Margin="0,4,0,12"/>
                            <TextBlock Text="Cotação usada na estimativa (US$ → R$)" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBox x:Name="DollarRateBox" Margin="0,4,0,12"/>
                            <TextBlock Text="Histórico enviado por conversa" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBox x:Name="HistoryLimitBox" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Permissões e privacidade" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="LocalDataBox" Content="Permitir consultas de leitura aos dados locais do SIGFUR" Margin="0,0,0,9"/>
                        <CheckBox x:Name="WebResearchBox" Content="Pesquisar legislação atual em fontes oficiais na internet" Margin="0,0,0,9"/>
                        <CheckBox x:Name="DeadlineNotificationsBox" Content="Mostrar alertas de pendências enquanto o SIGFUR estiver aberto" Margin="0,0,0,9"/>
                        <CheckBox x:Name="AttachmentsBox" Content="Permitir anexar documentos para análise" Margin="0,0,0,9"/>
                        <CheckBox x:Name="RedactBox" Content="Ocultar dados pessoais por padrão e liberar somente os campos pedidos no chat" Margin="0,0,0,9"/>
                        <CheckBox x:Name="SaveHistoryBox" Content="Salvar o histórico somente neste computador" Margin="0,0,0,9"/>
                        <CheckBox x:Name="ConfirmActionsBox" Content="Exigir confirmação antes de impressão e ações operacionais" Margin="0,0,0,9"/>
                        <CheckBox x:Name="HardBudgetBox" Content="Bloquear novas mensagens ao atingir o limite interno mensal"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Configuração avançada" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="O endereço muda automaticamente e aceita somente o domínio oficial do provedor selecionado." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10"/>
                        <TextBlock Text="Endereço base da API" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox x:Name="ApiBaseUrlBox" Margin="0,4,0,10" IsReadOnly="True" IsTabStop="False"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Alertar com antecedência (dias)"/><TextBox x:Name="DeadlineDaysBox" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Contexto máximo (caracteres)"/><TextBox x:Name="ContextLimitBox" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Etapas de consulta"/><TextBox x:Name="ToolRoundsBox" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Instruções adicionais do operador" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox x:Name="CustomInstructionsBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Estimativas incluem tokens e pesquisa web." Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="Salvar configuração" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
