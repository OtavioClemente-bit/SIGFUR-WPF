<Window x:Class="SIGFUR.Wpf.Views.Reminders.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGFUR — Painel de Prioridades" Width="1420" Height="860" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>

        <Border Background="{DynamicResource PrimaryDarkBrush}" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PAINEL DE PRIORIDADES" Foreground="White" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="Uma fila clara para decidir o que vem primeiro e concluir sem perder nenhuma providência."
                               Foreground="{DynamicResource TextOnPrimaryMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Nova tarefa detalhada" Style="{StaticResource LightOnDarkButtonStyle}" Click="New_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Captura rápida" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox x:Name="QuickTaskBox" FontSize="15" Padding="10,8" KeyDown="QuickTaskBox_KeyDown"
                                 ToolTip="Digite uma tarefa e pressione Enter"/>
                    </StackPanel>
                    <CheckBox x:Name="QuickUrgentBox" Grid.Column="1" Content="Urgente" VerticalAlignment="Bottom" Margin="16,0,16,9" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" Content="Adicionar à fila" Style="{StaticResource PrimaryButtonStyle}" Click="QuickAdd_Click" VerticalAlignment="Bottom" MinHeight="38"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="A FAZER" Style="{StaticResource MetricCaptionStyle}"/><TextBlock x:Name="ActiveText" Text="0" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border>
                <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="URGENTES" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource MetricCaptionStyle}"/><TextBlock x:Name="UrgentText" Text="0" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="PARA HOJE" Style="{StaticResource MetricCaptionStyle}"/><TextBlock x:Name="TodayText" Text="0" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource SoftMetricCardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CONCLUÍDAS" Style="{StaticResource MetricCaptionStyle}"/><TextBlock x:Name="CompletedText" Text="0" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Localizar na fila" Style="{StaticResource CaptionTextStyle}"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed"/></StackPanel>
                        <CheckBox x:Name="ShowCompletedBox" Grid.Column="1" Content="Exibir concluídas" VerticalAlignment="Bottom" Margin="14,0,0,8" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="4">
                    <DataGrid x:Name="ReminderGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="ReminderGrid_SelectionChanged" MouseDoubleClick="ReminderGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Subir na prioridade" Click="MoveUp_Click"/>
                                <MenuItem Header="Descer na prioridade" Click="MoveDown_Click"/>
                                <Separator/>
                                <MenuItem Header="Marcar / retirar urgência" Click="ToggleUrgent_Click"/>
                                <MenuItem Header="Editar detalhes" Click="Edit_Click"/>
                                <MenuItem Header="Concluir / reabrir" Click="Toggle_Click"/>
                                <Separator/>
                                <MenuItem Header="Excluir" Click="Delete_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Body}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="MinHeight" Value="40"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNextThree}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTopThree}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Urgent}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Setter Property="Opacity" Value="0.72"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ORDEM" Binding="{Binding OrderText}" Width="72"/>
                            <DataGridTextColumn Header="O QUE PRECISA SER FEITO" Binding="{Binding Title}" Width="*" MinWidth="300"/>
                            <DataGridTextColumn Header="ATENÇÃO" Binding="{Binding UrgentText}" Width="100"/>
                            <DataGridTextColumn Header="PRAZO" Binding="{Binding FormattedDate}" Width="105"/>
                            <DataGridTextColumn Header="SITUAÇÃO" Binding="{Binding DaysText}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Tarefa selecionada" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel Grid.Row="1" Margin="0,12,0,12">
                            <TextBlock x:Name="SelectedTitleText" Text="Nenhuma tarefa selecionada" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedInfoText" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SelectedBodyText" Text="Selecione uma tarefa para consultar as anotações." TextWrapping="Wrap" LineHeight="22"/></ScrollViewer>
                        </Border>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="↑ Subir" Style="{StaticResource SecondaryButtonStyle}" Click="MoveUp_Click" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="↓ Descer" Style="{StaticResource SecondaryButtonStyle}" Click="MoveDown_Click" Margin="4,0,0,0"/>
                            </Grid>
                            <Button Content="Marcar / retirar urgência" Style="{StaticResource SidebarActionButtonStyle}" Click="ToggleUrgent_Click"/>
                            <Button Content="Editar tarefa" Style="{StaticResource PrimaryButtonStyle}" Click="Edit_Click" Margin="0,7,0,0"/>
                            <Button Content="Concluir / reabrir" Style="{StaticResource SidebarActionButtonStyle}" Click="Toggle_Click"/>
                            <Button Content="Arquivar concluídas" Style="{StaticResource SidebarActionButtonStyle}" Click="Archive_Click"/>
                            <Button Content="Histórico" Style="{StaticResource SidebarActionButtonStyle}" Click="History_Click"/>
                            <Button Content="Exportar lista" Style="{StaticResource SidebarActionButtonStyle}" Click="Export_Click"/>
                            <Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Text="Enter adiciona  •  Ctrl+↑/↓ reorganiza  •  Espaço conclui"/>
            </Grid>
        </Border>
    </Grid>
</Window>
