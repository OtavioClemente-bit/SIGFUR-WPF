<Window x:Class="SIGFUR.Wpf.Views.Reminders.ReminderUrgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atenção prioritária" Width="900" Height="600" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ATENÇÃO PRIORITÁRIA" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="19"/>
                    <TextBlock x:Name="SummaryText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Foreground="White" FontWeight="Bold" FontSize="16"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4">
            <DataGrid x:Name="UrgentGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ORDEM" Binding="{Binding OrderText}" Width="72"/>
                    <DataGridTextColumn Header="PROVIDÊNCIA" Binding="{Binding Title}" Width="*" MinWidth="300"/>
                    <DataGridTextColumn Header="MOTIVO" Binding="{Binding StartupAttentionReason}" Width="150"/>
                    <DataGridTextColumn Header="PRAZO" Binding="{Binding FormattedDate}" Width="105"/>
                    <DataGridTextColumn Header="SITUAÇÃO" Binding="{Binding DaysText}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Este aviso aparece somente para urgências marcadas ou tarefas vencidas." Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Ver depois" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Abrir Painel de Prioridades" Style="{StaticResource PrimaryButtonStyle}" Click="Open_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
