<Window x:Class="SIGFUR.Wpf.Views.Furriel.FurrielBulletinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        Title="SIGFUR — Aditamento Furriel"
        Width="1560" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ProfessionalGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
        <Style x:Key="MetricPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PrimaryDarkBrush}" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ADITAMENTO FURRIEL" Foreground="White" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="Biblioteca consolidada, pesquisa instantânea de menções e vínculo com o índice oficial do SisBol"
                               Foreground="{DynamicResource TextOnPrimaryMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Importar ADTs" Style="{StaticResource LightOnDarkButtonStyle}" Click="ImportFiles_Click"
                            ToolTip="Importar PDFs ou arquivos ZIP de Aditamentos Furriel"/>
                    <Button Content="Importar pasta" Style="{StaticResource LightOnDarkButtonStyle}" Click="ImportFolder_Click" Margin="8,0,0,0"/>
                    <Button Content="Baixar ADTs do SisBol" Style="{StaticResource LightOnDarkButtonStyle}" Click="DownloadSisbolFurriel_Click" Margin="8,0,0,0"/>
                    <Button Content="Exportar individual" Style="{StaticResource LightOnDarkButtonStyle}" Click="ExportIndividualBulletin_Click" Margin="8,0,0,0"
                            ToolTip="Salvar uma cópia do aditamento selecionado"/>
                    <Button Content="Exportar intervalo" Style="{StaticResource LightOnDarkButtonStyle}" Click="ExportBulletinRange_Click" Margin="8,0,0,0"
                            ToolTip="Criar uma pasta organizada por ano e intervalo de números"/>
                    <Button Content="Enviar pelo EBMail" Style="{StaticResource LightOnDarkButtonStyle}" Click="SendEbMail_Click" Margin="8,0,0,0"
                            ToolTip="Preparar uma mensagem no EBMail com os ADTs selecionados"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="124"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Biblioteca de aditamentos" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="VisibleBulletinsText" Text="Nenhum aditamento disponível" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource InfoSoftBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                            <TextBlock x:Name="IndexedCountText" Text="0" Foreground="{DynamicResource InfoBrush}" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="BulletinFilterBox" TextChanged="BulletinFilterBox_TextChanged"
                                 ToolTip="Filtrar por número, data, BAR, ano ou nome do arquivo"/>
                        <Button Grid.Column="2" Content="Limpar" Style="{StaticResource GhostButtonStyle}" Click="ClearBulletinFilter_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="FilesGrid" Style="{StaticResource ProfessionalGridStyle}"
                              RowHeight="38" ColumnHeaderHeight="38" SelectionMode="Extended"
                              SelectionChanged="FilesGrid_SelectionChanged" MouseDoubleClick="FilesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ADT" Binding="{Binding DisplayBulletin}" Width="68"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding DisplayDate}" Width="84"/>
                            <DataGridTextColumn Header="Pág." Binding="{Binding Pages}" Width="48"/>
                            <DataGridTextColumn Header="Ass." Binding="{Binding SignedStatus}" Width="48"/>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding OriginalName}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Abrir PDF" Click="OpenSelectedPdf_Click"/>
                                <MenuItem Header="Abrir PDF assinado" Click="OpenSelectedSigned_Click"/>
                                <MenuItem Header="Reindexar selecionados" Click="Reindex_Click"/>
                                <MenuItem Header="Exportar aditamento individual" Click="ExportIndividualBulletin_Click"/>
                                <MenuItem Header="Exportar intervalo organizado" Click="ExportBulletinRange_Click"/>
                                <MenuItem Header="Enviar selecionados pelo EBMail" Click="SendEbMail_Click"/>
                                <Separator/>
                                <MenuItem Header="Usar como chave do aditamento" Click="UseAsBulletinKey_Click"/>
                                <MenuItem Header="Abrir pasta do arquivo" Click="OpenSelectedFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="Remover selecionados" Click="RemoveSelected_Click"/>
                                <MenuItem Header="Remover todos os aditamentos" Click="RemoveAll_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <WrapPanel Grid.Row="3" Margin="0,10,0,4">
                        <Button Content="Abrir PDF" Style="{StaticResource PrimaryButtonStyle}" Click="OpenSelectedPdf_Click" Margin="0,0,6,6"/>
                        <Button Content="Reindexar" Style="{StaticResource SecondaryButtonStyle}" Click="Reindex_Click" Margin="0,0,6,6"/>
                        <Button Content="Exportar individual" Style="{StaticResource SecondaryButtonStyle}" Click="ExportIndividualBulletin_Click" Margin="0,0,6,6"/>
                        <Button Content="Exportar intervalo" Style="{StaticResource SecondaryButtonStyle}" Click="ExportBulletinRange_Click" Margin="0,0,6,6"/>
                        <Button Content="EBMail" Style="{StaticResource SecondaryButtonStyle}" Click="SendEbMail_Click" Margin="0,0,6,6"/>
                        <Button Content="Remover selecionados" Style="{StaticResource DangerButtonStyle}" Click="RemoveSelected_Click" Margin="0,0,6,6"/>
                        <Button Content="Pasta" Style="{StaticResource SecondaryButtonStyle}" Click="OpenPdfFolder_Click" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,4,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="FileDetailBox" Text="Selecione um aditamento para ver os detalhes."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="5">
                        <CheckBox x:Name="AutoUpdateCheckBox" Content="Monitoramento automático desativado" Visibility="Collapsed" IsEnabled="False"
                                  Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed"/>
                        <Button Content="Atualizar biblioteca" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshIndex_Click"/>
                        <Button Content="Reindexar todos os ADTs" Style="{StaticResource SecondaryButtonStyle}" Click="ReindexAll_Click" Margin="0,7,0,0"/>
                        <Button Content="Esvaziar biblioteca" Style="{StaticResource DangerButtonStyle}" Click="RemoveAll_Click" Margin="0,7,0,0"
                                ToolTip="Remove os PDFs comuns e assinados; o Índice por Assunto é preservado"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="8">
                <TabControl>
                    <TabItem Header="Pesquisa e consequências">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/><RowDefinition Height="170"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Menções do Aditamento Furriel" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
                                    <TextBlock Text="Pesquise por militar ou texto livre e confira assunto/nota, consequência e origem em uma única linha."
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource MetricPillStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="Assinados  " Foreground="{DynamicResource SubtleTextBrush}"/><TextBlock x:Name="SignedCountText" Text="0" FontWeight="Bold"/></StackPanel></Border>
                                    <Border Style="{StaticResource MetricPillStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="Páginas  " Foreground="{DynamicResource SubtleTextBrush}"/><TextBlock x:Name="PagesCountText" Text="0" FontWeight="Bold"/></StackPanel></Border>
                                    <Border Style="{StaticResource MetricPillStyle}" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="Resultados  " Foreground="{DynamicResource SubtleTextBrush}"/><TextBlock x:Name="ResultsCountText" Text="0" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/></StackPanel></Border>
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1.65*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.7*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Militar" Style="{StaticResource FilterLabelStyle}"/>
                                        <ComboBox x:Name="MilitaryBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                  MaxDropDownHeight="340" SelectionChanged="MilitaryBox_SelectionChanged" KeyUp="SearchInput_KeyUp"
                                                  ToolTip="Nome, nome de guerra, CPF, IDT ou Prec-CP">
                                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="3,2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Rank}" FontWeight="SemiBold" Margin="0,0,6,0"/><controls:HighlightedNameTextBlock FullName="{Binding FullName}" WarName="{Binding WarName}"/></StackPanel><TextBlock Text="{Binding Source}" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Fonte dos nomes" Style="{StaticResource FilterLabelStyle}"/><ComboBox x:Name="PersonnelSourceBox" SelectionChanged="PersonnelSourceBox_SelectionChanged"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Assunto, nota ou texto" Style="{StaticResource FilterLabelStyle}"/><TextBox x:Name="FreeSearchBox" TextChanged="SearchInput_TextChanged" ToolTip="Pesquisa em assunto e nota ao mesmo tempo"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Text="Período" Style="{StaticResource FilterLabelStyle}"/><ComboBox x:Name="PeriodModeBox" SelectionChanged="PeriodModeBox_SelectionChanged"><ComboBoxItem Content="Mês/Ano"/><ComboBoxItem Content="Intervalo de datas"/></ComboBox></StackPanel>
                                    <Grid Grid.Column="8">
                                        <Grid x:Name="MonthYearPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mês" Style="{StaticResource FilterLabelStyle}"/><ComboBox x:Name="MonthBox" SelectionChanged="Filter_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ano" Style="{StaticResource FilterLabelStyle}"/><ComboBox x:Name="YearBox" SelectionChanged="Filter_Changed"/></StackPanel></Grid>
                                        <Grid x:Name="DateRangePanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data inicial" Style="{StaticResource FilterLabelStyle}"/><DatePicker x:Name="StartDatePicker" SelectedDateChanged="Filter_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Data final" Style="{StaticResource FilterLabelStyle}"/><DatePicker x:Name="EndDatePicker" SelectedDateChanged="Filter_Changed"/></StackPanel></Grid>
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="9" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SearchUnregisteredCheck" Content="Aceitar texto sem cadastro" IsChecked="True" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Consequências" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ConsequenceFilterBox" Width="240" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Apenas com consequência"/><ComboBoxItem Content="Apenas Furriel/Secretaria/Pagamento"/></ComboBox></StackPanel>
                                        <Button Grid.Column="4" Content="Pesquisar menções" Style="{StaticResource PrimaryButtonStyle}" Click="SearchNow_Click" MinWidth="150"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Padding="10,5" Margin="0,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HeaderStateText" Text="Índice pronto" Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="UpdatedAtText" Text="—" Foreground="{DynamicResource SubtleTextBrush}"/></Grid>
                            </Border>

                            <DataGrid Grid.Row="3" x:Name="ResultsGrid" Style="{StaticResource ProfessionalGridStyle}"
                                      SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Abrir PDF" Click="OpenSelectedPdf_Click"/><MenuItem Header="Abrir PDF assinado" Click="OpenSelectedSigned_Click"/><MenuItem Header="Exportar aditamento individual" Click="ExportIndividualBulletin_Click"/><Separator/><MenuItem Header="Copiar trecho" Click="CopySelectedContext_Click"/><MenuItem Header="Copiar referência" Click="CopySelectedReference_Click"/></ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Militar mencionado" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Military}" WarName="{Binding WarName}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Assunto / nota" Binding="{Binding SubjectNoteDisplay}" Width="310"/>
                                    <DataGridTextColumn Header="Consequência" Binding="{Binding ConsequenceDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="ADT" Binding="{Binding Bulletin}" Width="68"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="86"/>
                                    <DataGridTextColumn Header="Pág." Binding="{Binding Page}" Width="48"/>
                                    <DataGridTextColumn Header="Ass." Binding="{Binding Signed}" Width="48"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120"/>
                                    <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultDetailBox" Text="Selecione uma menção para conferir o texto da nota e a consequência." TextWrapping="Wrap"/></ScrollViewer>
                                    <Button Grid.Column="2" Content="Exportar ADT escolhido" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ExportIndividualBulletin_Click" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Índices e ferramentas">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Índices oficiais e operações" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
                                    <TextBlock Text="Baixe ou importe o Índice por Assunto para vincular cada menção à nota correta sem baixar novamente os ADTs." Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,0">
                                    <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}" Padding="16" Margin="0,0,8,8">
                                        <StackPanel><TextBlock Text="Índice por Assunto" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Atualiza assunto e nota das menções já salvas. Não exige novo download dos aditamentos." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,14"/><WrapPanel><Button Content="Baixar do SisBol" Style="{StaticResource PrimaryButtonStyle}" Click="DownloadSubjectIndex_Click" Margin="0,0,8,8"/><Button Content="Importar PDF" Style="{StaticResource SecondaryButtonStyle}" Click="ImportSubjectIndex_Click" Margin="0,0,8,8"/><Button Content="Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Click="ExportSubjectIndex_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}" Padding="16" Margin="8,0,0,8">
                                        <StackPanel><TextBlock Text="Índice por Pessoa" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Abre o histórico consolidado por pessoa no Boletim Inteligente, preservando todos os anos importados." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,14"/><Button Content="Abrir Índice por Pessoa" Style="{StaticResource PrimaryButtonStyle}" Click="OpenSisbolIndex_Click" HorizontalAlignment="Left"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}" Padding="16" Margin="0,8,8,0">
                                        <StackPanel><TextBlock Text="PDF assinado e chaves" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Vincule a versão assinada ao ADT selecionado ou use seus dados nas chaves automáticas." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,14"/><WrapPanel><Button Content="Salvar assinado" Style="{StaticResource PrimaryButtonStyle}" Click="ImportSigned_Click" Margin="0,0,8,8"/><Button Content="Abrir assinado" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSelectedSigned_Click" Margin="0,0,8,8"/><Button Content="Usar como chave" Style="{StaticResource SecondaryButtonStyle}" Click="UseAsBulletinKey_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}" Padding="16" Margin="8,8,0,0">
                                        <StackPanel><TextBlock Text="Exportação e manutenção" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Exporte a pesquisa, acesse os arquivos armazenados ou limpe todos os dados do módulo." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,14"/><WrapPanel><Button Content="Exportar resultados" Style="{StaticResource PrimaryButtonStyle}" Click="Export_Click" Margin="0,0,8,8"/><Button Content="Pasta assinados" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSignedFolder_Click" Margin="0,0,8,8"/><Button Content="Limpar módulo inteiro" Style="{StaticResource DangerButtonStyle}" Click="ClearBase_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PrimaryDarkBrush}" Padding="14,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Pronto." Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="F5 atualizar biblioteca  •  Ctrl+F pesquisar  •  Delete remover selecionados" Foreground="{DynamicResource TextOnPrimaryMutedBrush}" VerticalAlignment="Center"/></Grid>
        </Border>

        <controls:SigfurLoadingOverlay x:Name="BusyOverlay" Grid.RowSpan="3" Panel.ZIndex="50" Visibility="Collapsed" Title="Processando aditamentos" Message="Aguarde..."/>
    </Grid>
</Window>
