<Window x:Class="SIGFUR.Wpf.Views.Finance.SpedProcessAutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGFUR — Automação do SPED 3.0" Width="760" Height="690" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner" Icon="/Assets/sigfur.ico" Background="{DynamicResource AppBackgroundBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PrimaryGradientBrush}" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="AUTOMAÇÃO DO SPED" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="SPED 3.0 da 4ª RM • o remetente será o usuário autenticado" Foreground="#DCEBFF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="AccessTitleText" Text="ACESSO E DESTINATÁRIO" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Login ou CPF" Style="{StaticResource CaptionTextStyle}"/><TextBox x:Name="LoginBox" MinHeight="38"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Senha de acesso ao SPED" Style="{StaticResource CaptionTextStyle}"/><PasswordBox x:Name="LoginPasswordBox" MinHeight="38" Padding="9,6"/></StackPanel>
                        </Grid>
                        <CheckBox x:Name="SaveLoginPasswordCheck" Content="Salvar senha de acesso protegida neste usuário do Windows" Margin="0,9,0,0"/>
                        <StackPanel x:Name="RecipientPanel">
                            <TextBlock Text="Para quem o DIEx será enviado" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                            <TextBox x:Name="RecipientBox" MinHeight="38" ToolTip="Digite o nome ou termo usado na pesquisa de Destinatários do SPED"/>
                        </StackPanel>
                        <TextBlock Text="Interessado que aparecerá na capa do processo" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <TextBox x:Name="ProcessInterestedBox" MinHeight="38" ToolTip="Exemplo: Tesouraria da OM selecionada no perfil"/>
                        <StackPanel x:Name="ForwardRecipientPanel" Visibility="Collapsed">
                            <TextBlock Text="Quem assinará o despacho" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                            <TextBox x:Name="DispatchSignerBox" MinHeight="38" ToolTip="Digite o nome ou a função que identifica o assinante no SPED, por exemplo: Ordenador de Despesas."/>
                            <TextBlock Text="O despacho será criado antes do encaminhamento, com assunto e corpo preparados pelo SIGFUR." Style="{StaticResource SubtleTextStyle}" Margin="0,5,0,0"/>
                            <TextBlock Text="Para quem o processo será encaminhado depois do despacho" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                            <TextBox x:Name="ForwardRecipientBox" MinHeight="38" ToolTip="Digite um termo que identifique o destinatário no SPED, por exemplo: Comandante. Esta escolha ficará salva."/>
                            <TextBlock Text="O motivo será criado automaticamente a partir da finalidade do processo." Style="{StaticResource SubtleTextStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SignatureCard" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ASSINATURA ELETRÔNICA" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Senha eletrônica de assinatura (é diferente da senha de acesso)" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="SignaturePasswordBox" MinHeight="38" Padding="9,6"/>
                        <CheckBox x:Name="SaveSignaturePasswordCheck" Content="Salvar senha eletrônica protegida neste usuário do Windows" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DocumentNumberCard" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="DIEx DE ORIGEM" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Número gerado pelo SPED" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <TextBox x:Name="DocumentNumberBox" MinHeight="38" IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="O SIGFUR executará esta sequência" FontWeight="Bold"/>
                        <TextBlock x:Name="SequenceText" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatusCard" Style="{StaticResource CardStyle}" Padding="14">
                    <TextBlock x:Name="StatusText" Text="Pronto para abrir http://sped3.4rm.eb.mil.br/#/" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="A automação será executada em segundo plano; os PDFs ficarão salvos no processo local." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="Fechar" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                <Button x:Name="RunButton" Grid.Column="3" Content="Executar" Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click" MinWidth="220"/>
            </Grid>
        </Border>
    </Grid>
</Window>
