<Window x:Class="SIGFUR.Wpf.Views.Finance.BizurometroSpedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        Title="SIGFUR — SPED Processos" Width="1320" Height="850" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Icon="/Assets/sigfur.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PrimaryGradientBrush}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="SPED PROCESSOS" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="Criação completa do DIEx e do processo, da montagem ao encaminhamento" Foreground="#DCEBFF" Margin="0,4,0,0"/></StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="1. Criar DIEx" Style="{StaticResource LightOnDarkButtonStyle}" Click="CreateDiex_Click" Margin="0,0,8,4"/><Button Content="2. Criar processo" Style="{StaticResource LightOnDarkButtonStyle}" Click="CreateProcess_Click" Margin="0,0,8,4"/><Button Content="Gravar caminho" Style="{StaticResource LightOnDarkButtonStyle}" Click="OpenSpedLearning_Click" Margin="0,0,8,4" ToolTip="Grave manualmente um caminho novo no SPED e gere um ZIP para enviar."/><Button Content="Gerar textos" Style="{StaticResource LightOnDarkButtonStyle}" Click="GenerateTexts_Click" Margin="0,0,8,4"/><Button Content="Exportar resumo" Style="{StaticResource LightOnDarkButtonStyle}" Click="ExportSummary_Click" Margin="0,0,0,4"/></WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentProcessText" Text="NOVO PROCESSO — AINDA NÃO SALVO" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="SaveStateText" Text="Preencha os dados e salve quando desejar." Style="{StaticResource SubtleTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProcessTitleBox" VerticalContentAlignment="Center" ToolTip="Nome para identificar este processo" TextChanged="ProcessTitle_Changed"/>
                    <ComboBox x:Name="SavedProcessBox" Grid.Column="2" DisplayMemberPath="DisplayName" Visibility="Collapsed"/>
                    <Button Grid.Column="2" Content="Pesquisar processos salvos..." Style="{StaticResource SecondaryButtonStyle}" Click="OpenProcess_Click" ToolTip="Abrir a janela de pesquisa dos processos salvos"/>
                </Grid>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="＋ Novo" Style="{StaticResource SecondaryButtonStyle}" Click="NewProcess_Click" Margin="0,0,8,0"/>
                    <Button Content="Salvar processo" Style="{StaticResource PrimaryButtonStyle}" Click="SaveState_Click" Margin="0,0,8,0"/>
                    <Button Content="Duplicar" Style="{StaticResource SecondaryButtonStyle}" Click="DuplicateProcess_Click" Margin="0,0,8,0"/>
                    <Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Click="DeleteProcess_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DADOS DO PROCESSO" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Finalidade do processo" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="FlowBox" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="Form_Changed" LostKeyboardFocus="Form_Changed" ToolTip="Escolha uma opção ou escreva livremente a finalidade do processo."><ComboBoxItem Content="Inconsistência Bancária"/><ComboBoxItem Content="Bloqueio Bancário - TDBLOQ"/><ComboBoxItem Content="PP760 - CPEx"/><ComboBoxItem Content="Pagamento referente a dano ao erário"/><ComboBoxItem Content="Reposição ao erário"/><ComboBoxItem Content="Restituição de valores"/><ComboBoxItem Content="Regularização de pagamento"/><ComboBoxItem Content="Pagamento de direito reconhecido"/><ComboBoxItem Content="Cobrança ou recolhimento"/><ComboBoxItem Content="Outro — escrever finalidade"/></ComboBox>
                            <TextBlock Text="Para quem o DIEx será enviado" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="RecipientBox" TextChanged="Form_Changed" ToolTip="O remetente não precisa ser informado: será o usuário autenticado no SPED."/>
                            <TextBlock Text="Interessado do processo" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="ProcessInterestedBox" Text="Tesouraria da OM" TextChanged="Form_Changed" ToolTip="Campo Interessado(s) da capa do processo. Não é o destinatário do DIEx."/>
                            <TextBlock x:Name="OriginReferenceLabel" Text="Documento que determinou o valor" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <ComboBox x:Name="ReportBox" IsEditable="True" Text="TDINC" SelectionChanged="ReportBox_Changed" LostKeyboardFocus="ReportBox_Changed"/>
                            <TextBlock Text="Identificação do documento (número, data ou título)" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,4"/>
                            <TextBox x:Name="OriginDocumentReferenceBox" TextChanged="Form_Changed" ToolTip="Ex.: BI nº 123, de 10 AGO 26; Aditamento nº 4 ao BI nº 123; Solução de Sindicância de 10 AGO 26."/>
                            <TextBlock Text="Forma de beneficiário" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <ComboBox x:Name="BeneficiaryModeBox" SelectionChanged="Form_Changed"><ComboBoxItem Content="Um militar"/><ComboBoxItem Content="Relação anexa"/></ComboBox>
                            <TextBlock Text="Pesquisar no efetivo / LT" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="MilitaryPickerBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Display" KeyUp="MilitaryPickerBox_KeyUp" MaxDropDownHeight="430">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" MinWidth="330">
                                                <StackPanel>
                                                    <controls:HighlightedNameTextBlock FullName="{Binding Name, Mode=OneWay}" WarName="{Binding WarName, Mode=OneWay}" FontSize="13" TextWrapping="NoWrap"/>
                                                    <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}">
                                                        <Run Text="{Binding Rank, Mode=OneWay}"/><Run Text="  •  CPF "/><Run Text="{Binding FormattedCpf, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Source, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Usar" Style="{StaticResource SecondaryButtonStyle}" Click="UseMilitary_Click"/>
                            </Grid>
                            <TextBlock Text="Militar / identificação manual" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <TextBox x:Name="MilitaryBox" TextChanged="Form_Changed"/>
                            <Button Content="＋ Adicionar à relação anexa" Style="{StaticResource SecondaryButtonStyle}" Click="AddRelation_Click" Margin="0,7,0,0"/>
                            <TextBlock Text="Valor" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/><TextBox x:Name="ValueBox" TextChanged="Form_Changed"/>
                            <StackPanel x:Name="PublicationReferencePanel"><TextBlock x:Name="PublicationReferenceLabel" Text="Boletim / data (se houver)" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="BulletinBox" TextChanged="Form_Changed"/><DatePicker x:Name="BulletinDatePicker" Grid.Column="2" SelectedDateChanged="Form_Changed"/></Grid></StackPanel>
                            <StackPanel x:Name="PaymentReferencePanel"><TextBlock x:Name="PaymentReferenceLabel" Text="Referência financeira (se houver)" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/><ComboBox x:Name="PfBox" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="PaymentReference_Changed" LostKeyboardFocus="PaymentReference_Changed" ToolTip="Escolha GRU, depósito, forma de ressarcimento ou escreva outro documento."/></StackPanel>
                            <TextBlock Text="Observação" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/><TextBox x:Name="ObservationBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Form_Changed"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="15">
                        <StackPanel>
                            <TextBlock Text="DOCUMENTOS DO DIEx E DO PROCESSO" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="DocumentsHelpText" Text="Selecione somente os documentos aplicáveis à finalidade." TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,2"/>
                            <TextBlock x:Name="AttachmentsLimitText" Text="Limite do SPED: 10 MB no total." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,2"/>
                            <Button x:Name="PickOriginFileButton" Content="Selecionar documento que determinou o valor" Style="{StaticResource SecondaryButtonStyle}" Click="PickReport_Click" Margin="0,10,0,5"/><TextBlock x:Name="ReportFileText" Text="Não selecionado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="PublicationFilePanel"><Button x:Name="PickPublicationFileButton" Content="Selecionar publicação / boletim" Style="{StaticResource SecondaryButtonStyle}" Click="PickBulletin_Click" Margin="0,10,0,5"/><TextBlock x:Name="BulletinFileText" Text="Não selecionado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel x:Name="PaymentFilePanel"><Button x:Name="PickPaymentFileButton" Content="Selecionar documento financeiro" Style="{StaticResource SecondaryButtonStyle}" Click="PickPf_Click" Margin="0,10,0,5"/><TextBlock x:Name="PfFileText" Text="Não selecionado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel><Button Content="Adicionar ficha(s) financeira(s), se for o caso" Style="{StaticResource SecondaryButtonStyle}" Click="PickFinancialStatement_Click" Margin="0,10,0,5"/><TextBlock x:Name="FinancialStatementFileText" Text="Não selecionado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel><Button Content="Adicionar contracheque(s), se for o caso" Style="{StaticResource SecondaryButtonStyle}" Click="PickPaystub_Click" Margin="0,10,0,5"/><TextBlock x:Name="PaystubFileText" Text="Não selecionado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <Button Content="Adicionar outros anexos ao DIEx" Style="{StaticResource SecondaryButtonStyle}" Click="PickOther_Click" Margin="0,10,0,5"/><TextBlock x:Name="OtherFileText" Text="Não selecionado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/>
                            <Button Content="Vincular DIEx já existente (opcional)" Style="{StaticResource SecondaryButtonStyle}" Click="PickDiex_Click" Margin="0,10,0,5"/><TextBlock x:Name="DiexFileText" Text="Ainda não criado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Número do DIEx criado no SPED" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DiexNumberBox" TextChanged="Form_Changed" ToolTip="O SIGFUR preenche este número ao criar o DIEx. Também é possível informá-lo manualmente."/><Button Grid.Column="2" Content="Copiar" Style="{StaticResource SecondaryButtonStyle}" Click="CopyDiexNumber_Click"/></Grid>
                            <TextBlock Text="Processo salvo pelo SPED" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4"/>
                            <TextBlock x:Name="ProcessFileText" Text="Ainda não criado" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis"/>
                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="ARQUIVOS SALVOS PARA CONFERÊNCIA" FontWeight="Bold"/>
                            <ItemsControl x:Name="SavedFilesList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleTextStyle}"/></StackPanel><Button Grid.Column="1" Content="Abrir" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding Path}" Click="OpenSavedFile_Click" Padding="10,4"/><Button Grid.Column="3" Content="Remover" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Path}" Click="RemoveSavedFile_Click" Padding="10,4"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoSavedFilesText" Text="Nenhum arquivo selecionado." Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2">
                <TabItem Header="Orientação"><ScrollViewer><StackPanel Margin="16"><Border x:Name="StatusCard" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock x:Name="StatusTitle" Text="AGUARDANDO" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="PASSOS DO PROCESSO" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8"/><ItemsControl x:Name="StepsList"/></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Relação anexa"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="BENEFICIÁRIOS DA RELAÇÃO" Style="{StaticResource SectionTitleStyle}"/><DataGrid x:Name="RelationGrid" Grid.Row="1" Margin="0,10" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="P/G" Binding="{Binding Rank, Mode=OneWay}" Width="90"/><DataGridTemplateColumn Header="Nome completo / nome de guerra" Width="*" MinWidth="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HighlightedNameTextBlock FullName="{Binding Name, Mode=OneWay}" WarName="{Binding WarName, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="NoWrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="CPF" Binding="{Binding Cpf, Mode=OneWay}" Width="135"/><DataGridTextColumn Header="PREC-CP" Binding="{Binding PrecCp, Mode=OneWay}" Width="115"/><DataGridTextColumn Header="Origem" Binding="{Binding Source, Mode=OneWay}" Width="120"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button Content="Remover selecionados" Style="{StaticResource DangerButtonStyle}" Click="RemoveRelation_Click" Margin="0,0,8,0"/><Button Content="Limpar relação" Style="{StaticResource SecondaryButtonStyle}" Click="ClearRelation_Click"/></WrapPanel></Grid></TabItem>
                <TabItem Header="DIEx"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="DiexText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Arial" FontSize="13" TextChanged="GeneratedText_Changed"/><Button Grid.Row="1" Content="Copiar DIEx" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Click="CopyDiex_Click" Margin="0,10,0,0"/></Grid></TabItem>
                <TabItem Header="Checklist"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="Marcar tudo" Style="{StaticResource SecondaryButtonStyle}" Click="MarkAll_Click" Margin="0,0,8,0"/><Button Content="Desmarcar tudo" Style="{StaticResource GhostButtonStyle}" Click="UnmarkAll_Click"/></WrapPanel><ListBox x:Name="ChecklistList" Grid.Row="1" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Text}" IsChecked="{Binding Checked}" Margin="5" Click="Checklist_Changed"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Copiar checklist" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Click="CopyChecklist_Click" Margin="0,10,0,0"/></Grid></TabItem>
                <TabItem Header="Despacho"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="DispatchText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Arial" FontSize="13" TextChanged="GeneratedText_Changed"/><Button Grid.Row="1" Content="Copiar despacho" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Click="CopyDispatch_Click" Margin="0,10,0,0"/></Grid></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0"><TextBlock Text="Conferência: anexe ao DIEx todos os documentos que fundamentam o pedido; valores e referências existentes devem permanecer coerentes." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></Border>
    </Grid>
</Window>
