<Window x:Class="SIGFUR.Wpf.Views.Finance.AdjustmentBizuManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar motivo do ajuste" Width="1240" Height="790" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Selecionar motivo do ajuste" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Consulte a hipótese, confira os efeitos pecuniários e aplique somente depois da revisão." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,14"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource InsetCardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="PESQUISAR" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" MinHeight="38" VerticalContentAlignment="Center"
                         ToolTip="Pesquise pelo motivo, fundamento, orientação ou origem."/>
                <TextBlock x:Name="ResultCountText" Grid.Column="2" Text="0 hipóteses" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid x:Name="RulesGrid" SelectionChanged="RulesGrid_SelectionChanged" MouseDoubleClick="RulesGrid_MouseDoubleClick"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hipótese" Binding="{Binding Title}" Width="*" MinWidth="270"/>
                        <DataGridTextColumn Header="Férias" Binding="{Binding VacationAdditionalText}" Width="100"/>
                        <DataGridTextColumn Header="Indenização" Binding="{Binding VacationIndemnityText}" Width="105"/>
                        <DataGridTextColumn Header="13º" Binding="{Binding ChristmasAdditionalText}" Width="95"/>
                        <DataGridTextColumn Header="Pecuniária" Binding="{Binding PecuniaryText}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PRÉVIA DA REGRA" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBlock x:Name="RuleTitleText" Text="Selecione uma hipótese" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <TextBlock x:Name="OriginText" Text="—" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="RuleRightsPanel"/>

                        <Border Style="{StaticResource InsetCardStyle}" Padding="12" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="FUNDAMENTO" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock x:Name="LegalBasisText" Text="—" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="ORIENTAÇÃO" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0"/>
                                <TextBlock x:Name="ObservationText" Text="—" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Dê duplo clique em uma hipótese para aplicá-la." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nova regra" Style="{StaticResource SecondaryButtonStyle}" Click="Add_Click" Margin="0,0,8,0"/>
                <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}" Click="Edit_Click" Margin="0,0,8,0"/>
                <Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click" Margin="0,0,8,0"/>
                <Button Content="Restaurar padrões" Style="{StaticResource GhostButtonStyle}" Click="Restore_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="APLICAR MOTIVO" Style="{StaticResource PrimaryButtonStyle}" Click="Use_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
