<Window x:Class="SIGFUR.Wpf.Views.Finance.SpedReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIGFUR — Conferência do DIEx salvo no SPED"
        Width="1180" Height="800" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner" Icon="/Assets/sigfur.ico"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="CONFERÊNCIA DO DIEX" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock x:Name="MessageText" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="UrlText" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <ListBox x:Name="ScreenshotList" SelectionChanged="ScreenshotList_SelectionChanged" DisplayMemberPath="Name"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="None"/>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="As imagens mostram o conteúdo imediatamente antes e depois do salvamento automático." VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
            <WrapPanel Grid.Column="1">
                <Button Content="Abrir pasta do processo" Style="{StaticResource SecondaryButtonStyle}" Click="OpenFolder_Click" Margin="0,0,8,0"/>
                <Button Content="Concluir conferência" Style="{StaticResource PrimaryButtonStyle}" Click="Close_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
