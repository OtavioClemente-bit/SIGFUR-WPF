<Window x:Class="SIGFUR.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SIGFUR — Sistema Integrado de Gestão do Furriel"
        Icon="/Assets/sigfur.ico"
        Width="1180" Height="780" MinWidth="920" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="0"
                                  GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinHeight" Value="108"/>
        </Style>
        <Style x:Key="TopUtilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="UtilityBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UtilityBorder" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="UtilityBorder" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OperationalIssueRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Crítica">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Hoje">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Atenção">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IssueGridTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,3"/>
        </Style>
        <DataTemplate x:Key="IssuePersonCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PersonRank}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <controls:HighlightedNameTextBlock FullName="{Binding PersonName}" WarName="{Binding PersonWarName}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootGrid" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="15,0,12,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PrimarySoftBrush}">
                        <Image Source="/Assets/sigfur.png" Width="26" Height="26" Stretch="Uniform"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SIGFUR" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                        <TextBlock Text="Gestão do Furriel" FontSize="9" Foreground="{DynamicResource SubtleTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Tag="refresh_dashboard" Click="ButtonAction_Click" Style="{StaticResource TopUtilityButtonStyle}" ToolTip="Atualizar" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button Tag="appearance" Click="ButtonAction_Click" Style="{StaticResource TopUtilityButtonStyle}" ToolTip="Aparência" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button Tag="profile_sync" Click="ButtonAction_Click" Style="{StaticResource TopUtilityButtonStyle}" ToolTip="Perfil, Backup e Sincronizacao" Content="SYNC" FontSize="9" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Tag="font_up" Click="ButtonAction_Click" Style="{StaticResource TopUtilityButtonStyle}" ToolTip="Aumentar fonte" Content="A+" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Tag="font_reset" Click="ButtonAction_Click" Style="{StaticResource TopUtilityButtonStyle}" ToolTip="Fonte padrão" Content="A" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Tag="font_down" Click="ButtonAction_Click" Style="{StaticResource TopUtilityButtonStyle}" ToolTip="Diminuir fonte" Content="A−" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="2,0,8,0"/>
                    <Border Width="1" Height="22" Background="{DynamicResource DividerBrush}" Margin="2,0,4,0"/>
                    <Button x:Name="MinimizeControlButton" Style="{StaticResource WindowControlButtonStyle}"
                            Click="Minimize_Click" ToolTip="Minimizar" Focusable="False"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="16">
                            <Border Width="11" Height="1.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MaximizeControlButton" Style="{StaticResource WindowControlButtonStyle}"
                            Click="Maximize_Click" ToolTip="Maximizar" Focusable="False"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="16">
                            <Border x:Name="MaximizeSingleIcon" Width="10" Height="9" BorderThickness="1.4"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid x:Name="MaximizeRestoreIcon" Visibility="Collapsed" Width="13" Height="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="9" Height="8" BorderThickness="1.3" Margin="0,0,0,0"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Border Width="9" Height="8" BorderThickness="1.3" Margin="0,0,0,0" Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseControlButton" Style="{StaticResource CloseWindowControlButtonStyle}"
                            Click="Close_Click" ToolTip="Fechar" Focusable="False"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="16">
                            <Line X1="3" Y1="3" X2="13" Y2="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                            <Line X1="13" Y1="3" X2="3" Y2="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cabeçalho institucional -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryGradientBrush}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="440" Height="440" Fill="#0EFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-210,-270,0,0"/>
                <Ellipse Width="360" Height="360" Fill="#0AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-130,-230"/>
                <Grid Margin="22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="18" Background="#22FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                            <Grid>
                                <Image x:Name="HeroLogoImage" Width="56" Height="56" Stretch="Uniform" Visibility="Collapsed"/>
                                <Image x:Name="HeroFallbackLogo" Source="/Assets/sigfur-mark.png" Width="60" Height="60" Stretch="Uniform"
                                       SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProfileSubtitle}" Foreground="{DynamicResource TextOnPrimaryMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Background="#1FFFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentDate}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#1FFFFFFF" CornerRadius="8" Padding="10,5">
                                    <TextBlock Text="{Binding Dashboard.Version}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="PaymentReminderHeader_Click" Style="{StaticResource LightOnDarkButtonStyle}" Padding="14,8" Margin="0,0,10,0" MinWidth="225" ToolTip="Abrir e editar a corrida de pagamento">
                            <StackPanel>
                                <TextBlock Text="CORRIDA DE PAGAMENTO" Foreground="#DCEBFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="PaymentReferenceText" Text="Pagamento não definido" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                <TextBlock x:Name="FirstPaymentRunText" Text="1ª corrida: não definida" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="SecondPaymentRunText" Text="2ª corrida: não definida" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Button>
                        <Button Click="About_Click" Style="{StaticResource LightOnDarkButtonStyle}" Width="44" Height="44" Padding="0" Margin="0,0,8,0" ToolTip="Ajuda do SIGFUR">
                            <TextBlock Text="?" FontFamily="Segoe UI" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Tag="perfil" Click="ButtonAction_Click" Style="{StaticResource LightOnDarkButtonStyle}" Width="44" Height="44" Padding="0" Margin="0,0,10,0" ToolTip="Perfil, nome, OM e foto">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Content="Enviados SISBOL" Click="SisbolHistory_Click" Style="{StaticResource LightOnDarkButtonStyle}"
                                MinWidth="132" Padding="12,8" Margin="0,0,10,0" ToolTip="Pesquisar e copiar matérias já enviadas ao SISBOL"/>
                        <Button Content="{Binding SisbolText}" Command="{Binding PrepareSisbolCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="160" Padding="14,8"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navegação -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarHoverBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="306"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True"><Setter Property="Width" Value="74"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,12,12,8">
                        <TextBlock Text="NAVEGAÇÃO" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="9" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <Button HorizontalAlignment="Right" Command="{Binding ToggleNavigationCommand}" Style="{StaticResource NavActionButtonStyle}"
                                Width="42" Height="36" Padding="0" ToolTip="Recolher ou expandir menu">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding NavigationSearch, UpdateSourceTrigger=PropertyChanged}"
                             Margin="12,0,12,10" ToolTip="Pesquisar módulo"
                             Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding NavigationGroups}"
                                          Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="9" FontWeight="SemiBold" Margin="18,9,12,4"/>
                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource NavActionButtonStyle}"
                                                                Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding HotKey}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding AllActions}"
                                          Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavActionButtonStyle}" Width="58" Height="48" Padding="0"
                                                ToolTip="{Binding Title}"
                                                Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding OperatorName}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Operador conectado" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="9"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Dashboard -->
            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              IsDeferredScrollingEnabled="True" PanningMode="VerticalOnly"
                              UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <StackPanel Margin="22,20,22,24">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Visão geral" Style="{StaticResource PageTitleStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Painel operacional do furriel -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Central de rotina e pendências" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Prioridades, prazos e alertas automáticos no mesmo painel. Os três primeiros itens indicam o que deve ser executado antes." Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="14" Padding="14,7" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Total " Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Dashboard.OperationalIssueTotal}" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Grid.Row="1" Columns="5" Margin="0,16,0,0">
                                    <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="TAREFAS" Foreground="{DynamicResource WarningBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Dashboard.ReminderTotal}" Foreground="{DynamicResource WarningBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="ativos na rotina" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="ATRASADOS" Foreground="{DynamicResource DangerBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Dashboard.ReminderOverdue}" Foreground="{DynamicResource DangerBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="remarcar ou concluir" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="HOJE" Foreground="{DynamicResource WarningBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Dashboard.ReminderToday}" Foreground="{DynamicResource WarningBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="vence agora" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="CRÍTICAS" Foreground="{DynamicResource DangerBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Dashboard.OperationalIssueCritical}" Foreground="{DynamicResource DangerBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="antes da nota" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="ATENÇÃO" Foreground="{DynamicResource InfoBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Dashboard.OperationalIssueAttention}" Foreground="{DynamicResource InfoBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="conferência próxima" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TabControl Grid.Row="2" SelectedIndex="0" Margin="0,16,0,12" MinHeight="420" MaxHeight="540">
                                    <TabItem>
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Prioridades"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock Text="{Binding Dashboard.ReminderTotal}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Painel de Prioridades" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                                                    <TextBlock Text="Fila de providências definida por você. Os três primeiros itens recebem destaque máximo." Style="{StaticResource CaptionTextStyle}"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <Button Content="Nova tarefa" Style="{StaticResource PrimaryButtonStyle}" Click="NewReminder_Click" Margin="0,0,8,6" Padding="12,7" MinHeight="32"/>
                                                    <Button Content="Abrir prioridades" Tag="lembretes" Click="ButtonAction_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Padding="12,7" MinHeight="32"/>
                                                </WrapPanel>
                                            </Grid>

                                            <DataGrid x:Name="DashboardRemindersGrid" Grid.Row="1" ItemsSource="{Binding Dashboard.Reminders}" MinHeight="330" MaxHeight="455" Margin="0,10,0,0" MouseDoubleClick="DashboardRemindersGrid_MouseDoubleClick">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNextThree}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTopThree}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Urgent}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Atrasado">
                                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Hoje">
                                                                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
