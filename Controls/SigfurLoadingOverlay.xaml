<UserControl x:Class="SIGFUR.Wpf.Controls.SigfurLoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SIGFUR.Wpf.Controls"
             IsHitTestVisible="True" Focusable="True">
    <Grid Background="{DynamicResource OverlayBrush}">
        <Border Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:SigfurLoadingOverlay}}"
                MaxWidth="520" CornerRadius="18" Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.28" Color="{DynamicResource ShadowColor}"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="17,17,0,0" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12" Background="#22FFFFFF" Margin="0,0,14,0">
                            <Image Source="/SIGFUR;component/Assets/sigfur-mark.png" Width="39" Height="39" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SIGFUR" Foreground="#BFD8F4" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:SigfurLoadingOverlay}}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,8,0"/>
                        </StackPanel>
                        <Grid Grid.Column="2" Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Stroke="#55FFFFFF" StrokeThickness="3"/>
                            <Ellipse Stroke="White" StrokeThickness="3" StrokeDashArray="2,4" StrokeStartLineCap="Round">
                                <Ellipse.RenderTransform><RotateTransform CenterX="17" CenterY="17"/></Ellipse.RenderTransform>
                                <Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="22,20,22,22">
                    <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=controls:SigfurLoadingOverlay}}"
                               Foreground="{DynamicResource TextBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="7" Margin="0,18,0,0"/>
                    <Border Background="{DynamicResource PrimarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,15,0,0">
                        <TextBlock Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=controls:SigfurLoadingOverlay}}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
