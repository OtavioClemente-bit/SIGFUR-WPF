<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SIGFUR.Wpf.csproj" />
    <Compile Include="..\..\Services\AssistantResponsesProtocol.cs" Link="AssistantResponsesProtocol.cs" />
    <Compile Include="..\..\Services\AssistantOfficialResearch.cs" Link="AssistantOfficialResearch.cs" />
    <Resource Include="..\..\Assets\sigfur.ico" Link="Assets\sigfur.ico" />
  </ItemGroup>
</Project>
